---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<BaseLayout title="文章" description="宫水的全部文章。">
  <section class="page container">
    <header class="page-head">
      <p class="eyebrow">NOTES</p>
      <h1 class="serif">文章</h1>
      <p class="page-sub">长短不一，更新随缘。</p>
    </header>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/notes/${post.id}/`} class="post-item">
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <span class="post-title serif">{post.data.title}</span>
            <span class="post-desc">{post.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
