---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="The Blank Front Page">
  
  <!-- 彻底锁死滚动条的容器 -->
  <div class="scroll-lock" id="scroll-lock">
    <div class="scroll-content" id="scroll-content">
      
      <!-- WebGL 渲染层 -->
      <canvas id="webgl-canvas"></canvas>
      
      <!-- 高频白光过曝遮罩 -->
      <div class="flash-overlay" id="flash-overlay"></div>

      <!-- 自动轮播背景层 -->
      <div class="fixed-bg" id="bg-container">
        <div class="bg-image active" style="background-image: url('/bg1.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg2.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg3.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg4.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg5.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg6.jpg')"></div>
        <div class="fog-overlay"></div>
        <div class="vignette"></div>
      </div>

      <div class="content-wrapper">
        <section class="hero-section">
          <div class="title-container" id="hero-title">
            <div class="sub-title mono">EST. 1888 · LONDON</div>
            <h1 class="victorian-title">
              <span class="line-small">The</span>
              <span class="line-huge blood-splatter" data-text="Blank">Blank</span>
              <span class="line-medium">Front Page</span>
            </h1>
            <div class="vertical-line"></div>
          </div>
        </section>

        <div class="transition-spacer"></div>

        <section class="info-section" id="info-section">
          <div class="content-block" id="info-content">
            <h2 class="section-title">SEEKING PARTNERS</h2>
            <div class="roles-grid">
              <div class="role-item"><h3>UE5 / C++</h3><p>SYSTEM ARCHITECTURE</p></div>
              <div class="role-item"><h3>3D / LIGHTING</h3><p>ENVIRONMENT ART</p></div>
              <div class="role-item"><h3>NARRATIVE</h3><p>STORY & MECHANICS</p></div>
            </div>
            <div class="action-area">
              <a href="mailto:hi@gongshui.com" class="contact-btn mono">[ INITIATE CONTACT ]</a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  :global(body) {
    margin: 0; padding: 0;
    overflow: hidden;
    background-color: #030303;
    color: #e8e8e8;
    -webkit-font-smoothing: antialiased;
  }
  .mono { font-family: 'Courier New', Courier, monospace; }

  .scroll-lock {
    position: fixed; inset: 0;
    overflow-y: auto; overflow-x: hidden;
    scrollbar-width: none; -ms-overflow-style: none;
  }
  .scroll-lock::-webkit-scrollbar { display: none; }
  .scroll-content { position: relative; }

  /* WebGL 画布层 */
  #webgl-canvas {
    position: fixed; inset: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 10;
    mix-blend-mode: screen;
  }

  .flash-overlay {
    position: fixed; inset: 0;
    background: #fff;
    opacity: 0;
    pointer-events: none;
    z-index: 9;
  }

  /* 背景层（推拉过渡） */
  .fixed-bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
  .bg-image {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
    background-size: cover; background-position: center;
    filter: grayscale(80%) contrast(130%) brightness(0.25);
    opacity: 0;
    transform: scale(1.1);
    transition: opacity 2s ease-in-out, transform 3s ease-out, filter 2s ease-in-out;
    will-change: opacity, transform;
  }
  .bg-image.active {
    opacity: 1; transform: scale(1);
    filter: grayscale(80%) contrast(130%) brightness(0.35); z-index: 1;
  }

  .fog-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(3,3,3,0.2) 0%, rgba(3,3,3,0.8) 60%, #030303 100%);
    pointer-events: none; z-index: 2;
  }
  .vignette {
    position: absolute; inset: 0;
    background: radial-gradient(circle at 50% 30%, transparent 20%, #030303 90%);
    pointer-events: none; z-index: 3;
  }

  .content-wrapper { position: relative; z-index: 4; }
  .hero-section { min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; }
  .title-container { display: flex; flex-direction: column; align-items: center; will-change: transform, opacity, filter; }
  .sub-title { font-size: 11px; letter-spacing: 0.4em; color: #888; margin-bottom: 40px; }
  .victorian-title { font-family: 'Playfair Display', serif; display: flex; flex-direction: column; align-items: center; margin: 0; line-height: 0.9; }
  .line-small { font-size: clamp(28px, 5vw, 56px); font-style: italic; font-weight: 400; color: #a0a0a0; transform: translateX(-15vw); }
  .line-medium { font-size: clamp(32px, 7vw, 80px); font-style: italic; font-weight: 400; color: #d1c5b4; letter-spacing: 0.08em; transform: translateX(10vw); }
  .line-huge { position: relative; font-size: clamp(80px, 20vw, 240px); font-style: italic; font-weight: 400; color: #fff; letter-spacing: -0.01em; text-shadow: 0 10px 30px rgba(0,0,0,0.8); margin: -1vh 0; }

  .blood-splatter { position: relative; display: inline-block; }
  .blood-splatter::after {
    content: attr(data-text); position: absolute; left: 0; top: 0; z-index: -1;
    color: transparent;
    background-image: 
      radial-gradient(circle at 85% 15%, #9c0505 0%, #5a0000 25%, transparent 60%),
      radial-gradient(circle at 70% 10%, #8a0303 3%, transparent 10%);
    -webkit-background-clip: text; background-clip: text;
    opacity: 0; transform: scale(0.8) rotate(2deg); transform-origin: top right;
    animation: bloodSplat 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.5s forwards;
  }
  @keyframes bloodSplat {
    0% { opacity: 0; transform: scale(0.3) rotate(5deg); }
    60% { opacity: 1; transform: scale(1.05) rotate(-2deg); }
    100% { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  .vertical-line { width: 1px; height: 60px; background: linear-gradient(180deg, #555, transparent); margin-top: 40px; }
  .transition-spacer { height: 40vh; }
  .info-section { min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 40px 40px 100px; }
  .content-block { max-width: 1000px; width: 100%; will-change: transform, opacity; }
  .section-title { font-family: 'Playfair Display', serif; font-size: 14px; letter-spacing: 0.3em; font-weight: 400; color: #888; text-align: center; margin-bottom: 80px; }
  .roles-grid { display: grid; grid-template-columns: 1fr; gap: 60px; text-align: center; }
  @media (min-width: 768px) { .roles-grid { grid-template-columns: repeat(3, 1fr); } }
  .role-item h3 { font-family: 'Playfair Display', serif; font-size: 24px; font-style: italic; font-weight: 400; margin: 0 0 10px; color: #fff; }
  .role-item p { font-size: 11px; color: #777; letter-spacing: 0.1em; margin: 0; }
  .action-area { text-align: center; margin-top: 100px; }
  .contact-btn { display: inline-block; font-size: 13px; color: #fff; text-decoration: none; letter-spacing: 0.2em; border: 1px solid #444; padding: 20px 60px; background: rgba(0,0,0,0.3); backdrop-filter: blur(5px); transition: all 0.4s ease; }
  .contact-btn:hover { background: #fff; color: #000; border-color: #fff; }
</style>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';

  document.addEventListener('DOMContentLoaded', () => {
    const scrollLock = document.getElementById('scroll-lock');
    const flashOverlay = document.getElementById('flash-overlay');

    // ======= 1. 背景轮播 =======
    const bgs = document.querySelectorAll('.bg-image');
    let currentIndex = 0;
    setInterval(() => {
      bgs[currentIndex].classList.remove('active');
      bgs[currentIndex].style.zIndex = '0';
      currentIndex = (currentIndex + 1) % bgs.length;
      const newBg = bgs[currentIndex];
      newBg.style.zIndex = '1';
      newBg.style.transition = 'none';
      newBg.style.transform = 'scale(1.1)';
      void newBg.offsetWidth; 
      newBg.style.transition = 'opacity 2s ease-in-out, transform 3s ease-out, filter 2s ease-in-out';
      newBg.classList.add('active');
    }, 5000);

    // ======= 2. Three.js WebGL 渲染引擎 =======
    const canvas = document.getElementById('webgl-canvas');
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
    
    const scene = new THREE.Scene();
    // 透视相机，用于产生物理景深和镜头震颤
    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 10;

    // 后期处理：耀眼的泛光 (Bloom)
    const renderScene = new RenderPass(scene, camera);
    const bloomPass = new UnrealBloomPass(
      new THREE.Vector2(window.innerWidth, window.innerHeight),
      1.5,  // 强度
      0.4,  // 半径
      0.85  // 阈值
    );
    bloomPass.threshold = 0.1; // 降低阈值，让闪电带起强烈的溢光
    bloomPass.strength = 0;    // 初始不亮，闪电劈下时激活
    bloomPass.radius = 0.8;

    const composer = new EffectComposer(renderer);
    composer.addPass(renderScene);
    composer.addPass(bloomPass);

    // ======= 3. 生成有厚度的分形闪电几何体 =======
    let lightningMesh = null;
    let lineMaterial = new THREE.LineBasicMaterial({ color: 0xeeeeff, transparent: true, opacity: 0 });

    function createLightning() {
      if (lightningMesh) scene.remove(lightningMesh);

      const points = [];
      const startX = (Math.random() - 0.5) * 15; // 屏幕上方随机起点
      
      // 核心主干
      let currentX = startX;
      let currentY = 8;
      const step = 0.4;

      for (let y = 8; y > -5; y -= step) {
        points.push(new THREE.Vector3(currentX, y, 0));
        // 垂直方向的自然抖动
        currentX += (Math.random() - 0.5) * 1.2; 
      }

      // 使用 BufferGeometry 连成线
      const geometry = new THREE.BufferGeometry().setFromPoints(points);
      lightningMesh = new THREE.Line(geometry, lineMaterial);
      
      // 让闪电稍微倾斜
      lightningMesh.rotation.z = (Math.random() - 0.5) * 0.2;
      scene.add(lightningMesh);
    }

    // ======= 4. 物理雷电动画与镜头震动 =======
    let shakeIntensity = 0;
    let lightningActive = false;
    let flashTimeline = 0;

    function triggerLightning() {
      createLightning();
      lightningActive = true;
      flashTimeline = 0;
      
      // 瞬间爆闪
      bloomPass.strength = 4.0;
      lineMaterial.opacity = 1.0;
      shakeIntensity = 0.6; // 镜头剧烈震动

      // 高频频闪调度
      let pulseCount = 0;
      const pulseInterval = setInterval(() => {
        pulseCount++;
        if (pulseCount === 1) {
          // 第一次暗下
          bloomPass.strength = 1.5;
          lineMaterial.opacity = 0.3;
          shakeIntensity = 0.2;
        } else if (pulseCount === 2) {
          // 第二次小爆闪
          bloomPass.strength = 3.0;
          lineMaterial.opacity = 0.8;
          shakeIntensity = 0.4;
        } else if (pulseCount >= 3) {
          // 余晖衰减
          clearInterval(pulseInterval);
          bloomPass.strength = 0;
          lineMaterial.opacity = 0;
          shakeIntensity = 0;
          lightningActive = false;
          if (lightningMesh) scene.remove(lightningMesh);
        }
      }, 80);

      // 环境光遮罩闪烁
      flashOverlay.style.transition = 'none';
      flashOverlay.style.opacity = '0.6';
      setTimeout(() => {
        flashOverlay.style.transition = 'opacity 1s ease-out';
        flashOverlay.style.opacity = '0';
      }, 100);

      // 随机安排下一次雷击 (8~15秒)
      setTimeout(triggerLightning, Math.random() * 7000 + 8000);
    }

    // 延迟 2 秒启动第一次
    setTimeout(triggerLightning, 2000);

    // ======= 5. 渲染循环 =======
    const clock = new THREE.Clock();
    function animate() {
      requestAnimationFrame(animate);
      
      // 镜头震动算法 (物理阻尼震荡)
      if (shakeIntensity > 0) {
        camera.position.x = (Math.random() - 0.5) * shakeIntensity;
        camera.position.y = (Math.random() - 0.5) * shakeIntensity;
        shakeIntensity *= 0.85; // 迅速衰减
      } else {
        camera.position.x = 0;
        camera.position.y = 0;
      }

      composer.render();
    }
    animate();

    // 窗口尺寸适配
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      composer.setSize(window.innerWidth, window.innerHeight);
    });

    // ======= 6. 滚动文字动画 =======
    const heroTitle = document.getElementById('hero-title');
    const infoContent = document.getElementById('info-content');
    const infoSection = document.getElementById('info-section');
    
    scrollLock.addEventListener('scroll', () => {
      const scrollY = scrollLock.scrollTop;
      if (scrollY <= window.innerHeight) {
        const heroProg = scrollY / window.innerHeight;
        heroTitle.style.transform = `translateY(${scrollY * 0.4}px)`;
        heroTitle.style.opacity = 1 - heroProg;
        heroTitle.style.filter = `blur(${heroProg * 10}px)`;
      }
      const distance = infoSection.offsetTop - scrollY;
      if (distance < window.innerHeight && distance > 0) {
        const infoProg = 1 - (distance / window.innerHeight);
        infoContent.style.opacity = infoProg;
        infoContent.style.transform = `translateY(${(1 - infoProg) * 80}px)`;
      } else if (distance <= 0) {
        infoContent.style.opacity = 1;
        infoContent.style.transform = `translateY(0)`;
      }
    }, { passive: true });
  });
</script>
