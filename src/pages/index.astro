---
// 纯英文错落排版 + 金属质感 + 剧烈水波震荡
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MIYAMIZU</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;800&family=Inter:wght@200;300&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- SVG 滤镜：用于文字水波扭曲 -->
    <svg class="hidden-svg" aria-hidden="true">
      <defs>
        <filter id="water-ripple" x="-30%" y="-30%" width="160%" height="160%">
          <feTurbulence id="turbulence" type="fractalNoise" baseFrequency="0.01 0.01" numOctaves="3" result="noise" />
          <feDisplacementMap id="displacement" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>

    <!-- 水波视觉层 -->
    <div id="ripple-container" aria-hidden="true"></div>

    <!-- 内容区（非对称排版） -->
    <main class="layout" id="distort-target">
      <h1 class="text-1">TOO</h1>
      <h1 class="text-2">LAZY</h1>
      <h1 class="text-3">TO DO IT.</h1>

      <p class="sub-text">
        Bought the domain,<br>
        just make do with it.
      </p>

      <div class="meta-text">
        <span>MIYAMIZU.COM</span>
        <span>CLICK TO DISTORT</span>
      </div>
    </main>

    <script is:inline>
      const target = document.getElementById('distort-target');
      const turbulence = document.getElementById('turbulence');
      const displacement = document.getElementById('displacement');
      const rippleContainer = document.getElementById('ripple-container');

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let animId;
      let scale = 0;
      let freq = 0.01;
      let lastTime = 0;

      function triggerDistort() {
        if (prefersReducedMotion) return;

        cancelAnimationFrame(animId);

        scale = 150;
        freq = 0.008;

        displacement.setAttribute('scale', scale);
        turbulence.setAttribute('baseFrequency', `${freq} ${freq}`);
        target.style.filter = 'url(#water-ripple)';

        lastTime = 0;

        function animate(now) {
          if (now - lastTime < 33) {
            animId = requestAnimationFrame(animate);
            return;
          }
          lastTime = now;

          scale *= 0.9;
          freq += 0.0005;

          if (scale < 0.5) {
            target.style.filter = 'none';
            displacement.setAttribute('scale', 0);
            return;
          }

          displacement.setAttribute('scale', scale);
          turbulence.setAttribute('baseFrequency', `${freq} ${freq}`);

          animId = requestAnimationFrame(animate);
        }

        animId = requestAnimationFrame(animate);
      }

      function spawnRipple(x, y) {
        const ripple = document.createElement('div');
        ripple.className = 'ring';
        ripple.style.left = `${x}px`;
        ripple.style.top = `${y}px`;
        rippleContainer.appendChild(ripple);
        setTimeout(() => ripple.remove(), 2000);
      }

      document.body.addEventListener('pointerdown', (e) => {
        if (prefersReducedMotion) return;

        const { clientX, clientY } = e;

        triggerDistort();

        for (let i = 0; i < 3; i++) {
          setTimeout(() => spawnRipple(clientX, clientY), i * 150);
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0a0a0c;
    --text-metallic: linear-gradient(135deg, #ffffff 0%, #888b94 50%, #3a3c42 100%);
    --font-display: 'Syne', sans-serif;
    --font-sans: 'Inter', sans-serif;
  }

  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background-color: var(--bg);
    color: white;
    overflow: hidden;
    cursor: crosshair;
    font-family: var(--font-sans);
    user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  body {
    height: 100dvh;
  }

  .hidden-svg {
    position: absolute;
    width: 0;
    height: 0;
  }

  #ripple-container {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .layout {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    will-change: filter;
  }

  .text-1, .text-2, .text-3 {
    font-family: var(--font-display);
    font-weight: 800;
    margin: 0;
    line-height: 0.8;
    background: var(--text-metallic);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    position: absolute;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5));
  }

  .text-1 {
    font-size: clamp(6rem, 18vw, 20rem);
    top: 10%;
    left: 8%;
  }

  .text-2 {
    font-size: clamp(6rem, 20vw, 22rem);
    top: 35%;
    right: 12%;
  }

  .text-3 {
    font-size: clamp(5rem, 15vw, 16rem);
    bottom: 15%;
    left: 20%;
  }

  .sub-text {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.5rem);
    font-weight: 200;
    color: #a1a1aa;
    position: absolute;
    bottom: 12%;
    right: 10%;
    text-align: right;
    line-height: 1.6;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .meta-text {
    position: absolute;
    top: 5%;
    right: 5%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: #52525b;
    letter-spacing: 0.2em;
  }

  .ring {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
    animation: ripple-grow 2s cubic-bezier(0.1, 0.8, 0.2, 1) forwards;
  }

  @keyframes ripple-grow {
    0% { width: 10px; height: 10px; opacity: 1; border-width: 4px; }
    100% { width: 200vmax; height: 200vmax; opacity: 0; border-width: 1px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring { animation: none; }
    .layout { will-change: auto; }
  }
</style>
