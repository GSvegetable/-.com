---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="The Blank Front Page">
  
  <!-- 满屏固定背景层 -->
  <div class="fixed-bg">
    <div class="bg-image" id="bg-image"></div>
    <div class="bg-overlay"></div>
  </div>

  <!-- 第一页：巨大的维多利亚风居中排版 -->
  <section class="hero-section">
    <div class="title-container">
      <div class="sub-title mono">EST. 1888 · LONDON</div>
      
      <h1 class="victorian-title">
        <span class="line-small">The</span>
        <span class="line-huge">Blank</span>
        <span class="line-medium">Front Page</span>
      </h1>

      <div class="vertical-line"></div>
    </div>
  </section>

  <!-- 第二页：极简留白，透出背景图 -->
  <section class="info-section">
    <div class="content-block">
      <h2 class="section-title">SEEKING PARTNERS</h2>
      
      <div class="roles-grid">
        <div class="role-item">
          <h3>UE5 / C++</h3>
          <p>SYSTEM ARCHITECTURE</p>
        </div>
        <div class="role-item">
          <h3>3D / LIGHTING</h3>
          <p>ENVIRONMENT ART</p>
        </div>
        <div class="role-item">
          <h3>NARRATIVE</h3>
          <p>STORY & MECHANICS</p>
        </div>
      </div>

      <div class="action-area">
        <a href="mailto:hi@gongshui.com" class="contact-btn mono">
          [ INITIATE CONTACT ]
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(body) {
    background-color: #050505;
    color: #e8e8e8;
    margin: 0; padding: 0;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  .mono { font-family: 'Courier New', Courier, monospace; }

  /* 满屏背景层，固定在视口 */
  .fixed-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .bg-image {
    position: absolute;
    top: -10%; left: -5%;
    width: 110%; height: 120%;
    background-image: url('https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?q=80&w=2560&auto=format&fit=crop');
    background-size: cover;
    background-position: center 20%;
    filter: grayscale(100%) contrast(140%) brightness(0.2) sepia(30%);
    transform-origin: center center;
    will-change: transform;
  }

  /* 渐变遮罩：保证上下滑动时文字清晰，同时不会有硬切线 */
  .bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(5,5,5,0.6) 0%, rgba(5,5,5,0.2) 30%, rgba(5,5,5,0.8) 80%, #050505 100%);
    pointer-events: none;
  }

  /* 页面内容层 */
  .hero-section {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .title-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sub-title {
    font-size: 11px;
    letter-spacing: 0.4em;
    color: #888;
    margin-bottom: 40px;
  }

  /* 维多利亚风字体排版 */
  .victorian-title {
    font-family: 'Playfair Display', serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    line-height: 0.9;
  }

  /* 第一行：小巧倾斜 */
  .line-small {
    font-size: clamp(32px, 6vw, 64px);
    font-style: italic;
    font-weight: 400;
    color: #a0a0a0;
    transform: translateX(-15vw); /* 错位一点 */
  }

  /* 第二行：巨大、粗体倾斜 */
  .line-huge {
    font-size: clamp(90px, 22vw, 280px);
    font-style: italic;
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.02em;
    text-shadow: 0 10px 30px rgba(0,0,0,0.8);
    margin: -1vh 0;
  }

  /* 第三行：带点金色/灰白色的花体感 */
  .line-medium {
    font-size: clamp(36px, 8vw, 90px);
    font-style: italic;
    font-weight: 700;
    color: #d1c5b4; /* 复古羊皮纸色 */
    letter-spacing: 0.05em;
    transform: translateX(10vw); /* 往右错位 */
  }

  .vertical-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(180deg, #555, transparent);
    margin-top: 40px;
  }

  /* 第二页信息区 */
  .info-section {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 40px;
  }

  .content-block {
    max-width: 1000px;
    width: 100%;
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: 14px;
    letter-spacing: 0.3em;
    font-weight: 400;
    color: #888;
    text-align: center;
    margin-bottom: 80px;
  }

  .roles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 60px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .roles-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .role-item h3 {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    font-style: italic;
    font-weight: 400;
    margin: 0 0 10px;
    color: #fff;
  }

  .role-item p {
    font-size: 11px;
    color: #777;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .action-area {
    text-align: center;
    margin-top: 100px;
  }

  .contact-btn {
    display: inline-block;
    font-size: 13px;
    color: #fff;
    text-decoration: none;
    letter-spacing: 0.2em;
    border: 1px solid #444;
    padding: 20px 60px;
    background: rgba(0,0,0,0.3);
    backdrop-filter: blur(5px);
    transition: all 0.4s ease;
  }

  .contact-btn:hover {
    background: #fff;
    color: #000;
    border-color: #fff;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const bgImage = document.getElementById('bg-image');
    
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      // 滚动时，背景图缓缓放大（scale），给极强的空间吸入感
      const scale = 1 + scrollY * 0.0005;
      bgImage.style.transform = `scale(${scale})`;
    }, { passive: true });
  });
</script>
