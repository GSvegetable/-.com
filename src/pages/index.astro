---
// 纯手写英伦风 + Canvas 物理水波纹（带回弹）
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>宫水.com</title>
    <!-- 引入极夸张的英伦花体与中文狂草 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Liu+Jian+Mao+Cao&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- 主画布，用于物理水波渲染 -->
    <canvas id="water-canvas"></canvas>
    
    <!-- 提示文案 -->
    <div class="hint">CLICK / DRAG TO DISTORT</div>

    <script is:inline>
      const canvas = document.getElementById('water-canvas');
      const ctx = canvas.getContext('2d', { willReadFrequently: true });

      let width, height;
      let textCanvas, textCtx;
      let textImageData;
      let originalData;
      
      // 水波物理引擎变量
      let current = [];
      let previous = [];
      let damping = 0.985; // 阻尼，越小波纹消散越快 (0.985非常缓慢，能层层晕开)
      let waveSpeed = 0.5; // 波纹扩散速度
      let resolution = 2; // 分辨率缩放比例（为了性能）
      let simWidth, simHeight;

      // 1. 初始化画布与文字
      async function init() {
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = width;
        canvas.height = height;

        // 等待字体加载完毕
        await document.fonts.load('12rem "Pinyon Script"');
        await document.fonts.load('12rem "Liu Jian Mao Cao"');

        // 创建离屏 Canvas 用来画字
        textCanvas = document.createElement('canvas');
        textCanvas.width = width;
        textCanvas.height = height;
        textCtx = textCanvas.getContext('2d', { willReadFrequently: true });

        drawText();

        // 获取文字像素数据
        textImageData = textCtx.getImageData(0, 0, width, height);
        originalData = new Uint8ClampedArray(textImageData.data);

        // 初始化水波物理数组
        simWidth = Math.floor(width / resolution);
        simHeight = Math.floor(height / resolution);
        current = new Float32Array(simWidth * simHeight);
        previous = new Float32Array(simWidth * simHeight);

        // 启动动画循环
        requestAnimationFrame(render);
      }

      // 2. 绘制排版与字体
      function drawText() {
        textCtx.fillStyle = '#050505'; // 纯黑背景
        textCtx.fillRect(0, 0, width, height);
        
        textCtx.textAlign = 'center';
        textCtx.textBaseline = 'middle';

        // 中文狂草 “懒得做了”
        textCtx.fillStyle = '#f5f5f5';
        let cnSize = Math.min(width * 0.15, 200);
        textCtx.font = `${cnSize}px "Liu Jian Mao Cao", cursive`;
        textCtx.fillText('懒得做了', width / 2, height / 2 - 30);

        // 英文花体 “TOO LAZY TO DO IT”
        textCtx.fillStyle = '#d4af37'; // 烫金色
        let enSize = Math.min(width * 0.06, 80);
        textCtx.font = `${enSize}px "Pinyon Script", cursive`;
        textCtx.fillText('Too Lazy To Do It', width / 2, height / 2 + 100);

        // 中文细体 “但域名都买了，凑合看吧”
        textCtx.fillStyle = 'rgba(255, 255, 255, 0.6)';
        let subSize = Math.min(width * 0.02, 20);
        textCtx.font = `${subSize}px sans-serif`;
        textCtx.letterSpacing = '5px';
        textCtx.fillText('但域名都买了，凑合看吧', width / 2, height / 2 + 180);
      }

      // 3. 触发水波 (鼠标点击或拖动)
      function disturb(x, y) {
        let sx = Math.floor(x / resolution);
        let sy = Math.floor(y / resolution);
        let index = sx + sy * simWidth;
        if (index >= 0 && index < current.length) {
          // 注入能量（激起水波）
          current[index] = 500; 
        }
      }

      window.addEventListener('pointerdown', e => disturb(e.clientX, e.clientY));
      window.addEventListener('pointermove', e => {
        if (e.buttons === 1) { // 按住鼠标拖动
          disturb(e.clientX, e.clientY);
        }
      });

      // 4. 物理水波核心计算 (波方程)
      function updateWave() {
        for (let y = 1; y < simHeight - 1; y++) {
          for (let x = 1; x < simWidth - 1; x++) {
            let i = x + y * simWidth;
            
            // 核心波动方程：计算周围四个点的平均值减去当前点
            let wave = (previous[i - 1] + previous[i + 1] + previous[i - simWidth] + previous[i + simWidth]) / 2 - current[i];
            
            // 加上阻尼，波纹会慢慢消失
            current[i] = wave * damping;
          }
        }

        // 边缘回弹处理 (将上一帧的数据和当前帧交换)
        let temp = previous;
        previous = current;
        current = temp;
      }

      // 5. 渲染画面并扭曲像素
      function render() {
        updateWave();

        // 重置像素数据
        textImageData.data.set(originalData);
        let data = textImageData.data;

        // 根据水波高度扭曲文字像素
        for (let y = 1; y < simHeight - 1; y++) {
          for (let x = 1; x < simWidth - 1; x++) {
            let i = x + y * simWidth;
            
            // 计算折射偏移量
            let xOffset = Math.floor(previous[i - 1] - previous[i + 1]);
            let yOffset = Math.floor(previous[i - simWidth] - previous[i + simWidth]);

            // 映射回真实像素坐标
            let px = x * resolution;
            let py = y * resolution;
            
            let targetX = px + xOffset;
            let targetY = py + yOffset;

            // 边界检查
            if (targetX >= 0 && targetX < width && targetY >= 0 && targetY < height) {
              let srcIndex = (targetX + targetY * width) * 4;
              let destIndex = (px + py * width) * 4;

              // 位移扭曲像素
              data[destIndex] = originalData[srcIndex];         // R
              data[destIndex + 1] = originalData[srcIndex + 1]; // G
              data[destIndex + 2] = originalData[srcIndex + 2]; // B
            }
          }
        }

        // 绘制到主画布
        ctx.putImageData(textImageData, 0, 0);

        requestAnimationFrame(render);
      }

      // 启动
      init();

      // 窗口缩放时重新初始化
      window.addEventListener('resize', () => {
        // 为了简单，直接刷新页面
        window.location.reload(); 
      });
    </script>

    <style>
      html, body {
        margin: 0; padding: 0;
        width: 100%; height: 100%;
        background: #050505;
        overflow: hidden;
        cursor: crosshair;
      }
      #water-canvas {
        display: block;
        width: 100%; height: 100%;
      }
      .hint {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        color: rgba(255, 255, 255, 0.2);
        font-family: monospace;
        font-size: 12px;
        letter-spacing: 3px;
        pointer-events: none;
        animation: pulse 3s infinite alternate;
      }
      @keyframes pulse {
        from { opacity: 0.2; }
        to { opacity: 0.8; }
      }
    </style>
  </body>
</html>
