---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="雾都疑云" description="1888 伦敦独立游戏计划">
  
  <!-- 极简视差背景层 (使用真实高精度建筑图) -->
  <div class="parallax-bg">
    <div class="bg-layer" id="bg-layer"></div>
    <div class="vignette-overlay"></div>
  </div>

  <div class="content-wrapper">
    <!-- 首屏：极致的字号反差与空间感 -->
    <section class="hero-section">
      <div class="mono meta-tag">EST. 1888 / LONDON</div>
      
      <h1 class="mega-title">
        <span class="outline">THE</span>
        <span class="solid">FOG</span>
      </h1>
      
      <div class="hero-bottom">
        <h2 class="cn-title">雾都疑云</h2>
        <p class="mono minimal-desc">
          UE5 / INDIE GAME PROJECT<br>
          SEEKING PARTNERS
        </p>
      </div>
    </section>

    <!-- 下半部分：大面积留白与极简的招募信息 -->
    <section class="info-section">
      <div class="divider"></div>
      
      <div class="roles-grid">
        <div class="role-item">
          <span class="mono num">01</span>
          <h3>系统开发</h3>
          <p>UE5 / C++</p>
        </div>
        
        <div class="role-item">
          <span class="mono num">02</span>
          <h3>场景地编</h3>
          <p>MATERIAL / LIGHTING</p>
        </div>
        
        <div class="role-item">
          <span class="mono num">03</span>
          <h3>剧情策划</h3>
          <p>NARRATIVE / DESIGN</p>
        </div>
      </div>

      <div class="divider" style="margin-top: 80px;"></div>

      <!-- 极简底栏 -->
      <div class="footer-action">
        <a href="mailto:hi@gongshui.com" class="contact-link mono">
          [ INITIATE CONTACT ]
        </a>
        <p class="mono text-muted" style="font-size: 10px; margin-top: 20px;">GONG SHUI STUDIO</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* 彻底重置，适配极简暗黑风 */
  :global(body) {
    background-color: #050505;
    color: #e8e8e8;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    font-family: var(--serif);
    -webkit-font-smoothing: antialiased;
  }

  /* 真实建筑视差背景 */
  .parallax-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .bg-layer {
    position: absolute;
    top: -10%;
    left: -5%;
    width: 110%;
    height: 120%;
    /* 使用一张极高质量的真实伦敦老街/哥特建筑无版权图 */
    background-image: url('https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?q=80&w=2560&auto=format&fit=crop');
    background-size: cover;
    background-position: center 20%;
    /* 将图片处理成深沉的黑白灰/暗金调，强调建筑线条细节 */
    filter: grayscale(100%) contrast(130%) brightness(0.25) sepia(20%);
    transform-origin: center center;
    will-change: transform;
  }

  .vignette-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 30%, transparent 20%, #050505 90%);
    pointer-events: none;
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
  }

  .mono { font-family: var(--mono); }
  .text-muted { color: #777; }

  /* 首屏排版 */
  .hero-section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 60px 40px 80px;
  }

  @media (min-width: 768px) {
    .hero-section { padding: 80px 10vw; }
  }

  .meta-tag {
    font-size: 11px;
    letter-spacing: 0.3em;
    color: #888;
    border-left: 1px solid #444;
    padding-left: 12px;
  }

  /* 极致的字体反差：巨大的空心字与实心字 */
  .mega-title {
    font-family: 'Times New Roman', Times, serif;
    font-size: clamp(80px, 22vw, 280px);
    line-height: 0.8;
    margin: 40px 0;
    display: flex;
    flex-direction: column;
  }

  .mega-title .outline {
    color: transparent;
    -webkit-text-stroke: 1px #333;
    letter-spacing: -0.02em;
  }

  .mega-title .solid {
    color: #e8e8e8;
    font-style: italic;
    margin-left: 20vw; /* 错位排版，增加空间感 */
  }

  .hero-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: auto;
    border-bottom: 1px solid #222;
    padding-bottom: 30px;
  }

  .cn-title {
    font-size: clamp(24px, 4vw, 48px);
    font-weight: 400;
    letter-spacing: 0.5em;
    margin: 0;
  }

  .minimal-desc {
    font-size: 11px;
    line-height: 1.8;
    text-align: right;
    color: #888;
    margin: 0;
  }

  /* 信息区：大面积留白 */
  .info-section {
    background: #050505;
    padding: 100px 40px;
  }

  @media (min-width: 768px) {
    .info-section { padding: 150px 10vw; }
  }

  .divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, #333, transparent);
    margin-bottom: 60px;
  }

  .roles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 60px;
  }

  @media (min-width: 768px) {
    .roles-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .role-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .num {
    font-size: 10px;
    color: #555;
  }

  .role-item h3 {
    font-size: 22px;
    margin: 0;
    font-weight: 400;
    color: #fff;
  }

  .role-item p {
    font-size: 11px;
    color: #777;
    margin: 0;
    letter-spacing: 0.1em;
  }

  /* 底部触发点 */
  .footer-action {
    text-align: center;
    margin-top: 60px;
  }

  .contact-link {
    display: inline-block;
    font-size: 14px;
    color: #fff;
    text-decoration: none;
    letter-spacing: 0.2em;
    border: 1px solid #333;
    padding: 20px 50px;
    transition: all 0.4s ease;
  }

  .contact-link:hover {
    background: #fff;
    color: #000;
    border-color: #fff;
  }
</style>

<script is:inline>
  // 监听滚动，实现背景视差与缩放
  document.addEventListener('DOMContentLoaded', () => {
    const bgLayer = document.getElementById('bg-layer');
    
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      // 让背景缓缓向上移动，同时带一点点视觉放大
      bgLayer.style.transform = `translateY(${scrollY * 0.3}px) scale(${1 + scrollY * 0.0002})`;
    }, { passive: true });
  });
</script>
