---
// 纯黑底 + 极简居中 + 英国华丽手写体 + 微弱高光阴影质感
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Make do</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Pinyon+Script&display=swap" rel="stylesheet">
  </head>
  <body>
    <main class="wrapper">
      <h1 class="text-main">Make do</h1>
      <h2 class="text-sub">aesthetic offline today</h2>
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    /* 稍微给一点点不是纯黑的底色，让高光有地方落脚 */
    background-color: #050505; 
    color: #ffffff;
  }

  .wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* 提取公共质感样式 */
  .text-main, .text-sub {
    /* 使用对角银灰渐变，模拟高级纸张或微弱的金属反光 */
    background: linear-gradient(135deg, #ffffff 0%, #9ca3af 50%, #f3f4f6 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    
    /* 极其微弱的高光与阴影：上方1px高光，下方微弱黑影产生浮雕感 */
    filter: drop-shadow(0px 1px 1px rgba(255, 255, 255, 0.15)) 
            drop-shadow(0px 4px 10px rgba(0, 0, 0, 0.8));
  }

  .text-main {
    font-family: 'Pinyon Script', cursive;
    font-size: clamp(6rem, 18vw, 20rem);
    line-height: 1;
    font-weight: 400;
    margin-bottom: -2vw; 
  }

  .text-sub {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(2.5rem, 6vw, 7rem);
    line-height: 1.5;
    font-weight: 400;
    /* 副标题压暗一点，保持层次感 */
    opacity: 0.7;
  }
</style>
