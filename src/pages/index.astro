---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="The Blank Front Page">
  
  <div class="scroll-lock" id="scroll-lock">
    <div class="scroll-content" id="scroll-content">
      
      <!-- 纯 CSS 动态浓雾 (不再使用 WebGL，保证 60 帧顺滑) -->
      <div class="css-fog-layer"></div>

      <!-- 轮播背景层 -->
      <div class="fixed-bg" id="bg-container">
        <div class="bg-image active" style="background-image: url('/bg1.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg2.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg3.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg4.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg5.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg6.jpg')"></div>
        <div class="fog-overlay"></div>
        <div class="vignette"></div>
      </div>

      <div class="content-wrapper">
        <!-- 第一页：完美居中固定，只做淡出 -->
        <section class="hero-section">
          <div class="newspaper-masthead" id="hero-title">
            <div class="masthead-top">
              <span>VOL. I</span>
              <span>LONDON GAZETTE</span>
              <span>EST. 1888</span>
            </div>

            <div class="masthead-center">
              <span class="pre-title">The</span>
              <div class="title-wrap">
                <h1 class="main-title blood-splatter" data-text="Blank">Blank</h1>
                <span class="post-title">FRONT PAGE</span>
              </div>
            </div>

            <div class="masthead-bottom">
              <div class="line"></div>
              <span class="mono">CONFIDENTIAL / SEEKING PARTNERS</span>
              <div class="line"></div>
            </div>
          </div>
        </section>

        <!-- 留出滚动空间 -->
        <div class="transition-spacer"></div>

        <!-- 第二页：正常滚动 -->
        <section class="info-section" id="info-section">
          <div class="content-block" id="info-content">
            <h2 class="section-title">SEEKING PARTNERS</h2>
            <div class="roles-grid">
              <div class="role-item"><h3>UE5 / C++</h3><p>SYSTEM ARCHITECTURE</p></div>
              <div class="role-item"><h3>3D / LIGHTING</h3><p>ENVIRONMENT ART</p></div>
              <div class="role-item"><h3>NARRATIVE</h3><p>STORY & MECHANICS</p></div>
            </div>
            <div class="action-area">
              <a href="mailto:hi@gongshui.com" class="contact-btn mono">[ INITIATE CONTACT ]</a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  :global(body) {
    margin: 0; padding: 0;
    overflow: hidden;
    background-color: #030303;
    color: #e8e8e8;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  .mono { font-family: 'Courier New', Courier, monospace; }

  .scroll-lock {
    position: fixed; inset: 0;
    overflow-y: auto; overflow-x: hidden;
    scrollbar-width: none; -ms-overflow-style: none;
    /* 开启原生惯性滚动 */
    -webkit-overflow-scrolling: touch; 
  }
  .scroll-lock::-webkit-scrollbar { display: none; }
  .scroll-content { position: relative; }

  /* 静态但带呼吸感的 CSS 雾气遮罩 */
  .css-fog-layer {
    position: fixed; inset: 0;
    z-index: 1; pointer-events: none;
    background: radial-gradient(circle at 20% 30%, rgba(40, 45, 55, 0.4) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(30, 35, 45, 0.5) 0%, transparent 60%);
    animation: fogMove 20s infinite alternate linear;
  }

  @keyframes fogMove {
    0% { transform: scale(1) translate(0, 0); }
    100% { transform: scale(1.1) translate(2%, 2%); }
  }

  .fixed-bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
  .bg-image {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
    background-size: cover; background-position: center;
    filter: grayscale(100%) contrast(130%) brightness(0.2);
    opacity: 0;
    /* 移除会导致抖动的高开销滤镜动画 */
    transition: opacity 3s ease-in-out; 
    will-change: opacity;
  }
  .bg-image.active {
    opacity: 1; z-index: 1;
  }

  .fog-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(3,3,3,0.1) 0%, rgba(3,3,3,0.8) 60%, #030303 100%);
    pointer-events: none; z-index: 2;
  }
  .vignette {
    position: absolute; inset: 0;
    background: radial-gradient(circle at 50% 30%, transparent 10%, #030303 90%);
    pointer-events: none; z-index: 3;
  }

  .content-wrapper { position: relative; z-index: 4; }
  
  /* ======= 第一页排版 ======= */
  .hero-section { 
    min-height: 100vh; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    padding: 40px;
  }

  .newspaper-masthead {
    width: 100%; max-width: 900px;
    display: flex; flex-direction: column;
    /* 强制 GPU 加速，锁定图层 */
    transform: translateZ(0);
    will-change: opacity;
  }

  /* 移除所有 text-shadow，极大减轻渲染压力 */
  .masthead-top {
    display: flex; justify-content: space-between;
    border-top: 1px solid rgba(255,255,255,0.2);
    border-bottom: 1px solid rgba(255,255,255,0.2);
    padding: 12px 0;
    font-family: 'Courier New', monospace;
    font-size: 11px; letter-spacing: 0.2em; color: #888;
  }

  .masthead-center { display: flex; flex-direction: column; padding: 60px 0; position: relative; }
  .pre-title { font-family: 'Playfair Display', serif; font-size: clamp(40px, 8vw, 80px); font-style: italic; color: #a0a0a0; margin-bottom: -20px; margin-left: 5vw; position: relative; z-index: 2; }
  .title-wrap { display: flex; flex-direction: column; align-items: flex-end; }
  .main-title { position: relative; font-family: 'Playfair Display', serif; font-size: clamp(100px, 22vw, 260px); font-style: italic; font-weight: 400; color: #fff; letter-spacing: -0.02em; line-height: 0.8; margin: 0; z-index: 1; }
  .post-title { font-family: 'Courier New', monospace; font-size: clamp(14px, 2vw, 18px); letter-spacing: 0.8em; color: #d1c5b4; margin-top: 20px; margin-right: 20px; }

  .masthead-bottom { display: flex; align-items: center; gap: 20px; }
  .masthead-bottom .line { flex: 1; height: 1px; background: rgba(255,255,255,0.2); }
  .masthead-bottom span { font-size: 10px; letter-spacing: 0.3em; color: #666; }

  .blood-splatter::after {
    content: attr(data-text); position: absolute; left: 0; top: 0; z-index: -1;
    color: transparent;
    background-image: radial-gradient(circle at 85% 15%, #9c0505 0%, #5a0000 25%, transparent 60%), radial-gradient(circle at 70% 10%, #8a0303 3%, transparent 10%);
    -webkit-background-clip: text; background-clip: text;
    opacity: 0; transform: scale(0.8) rotate(2deg); transform-origin: top right;
    animation: bloodSplat 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.5s forwards;
  }
  @keyframes bloodSplat {
    0% { opacity: 0; transform: scale(0.3) rotate(5deg); }
    60% { opacity: 1; transform: scale(1.05) rotate(-2deg); }
    100% { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  /* ======= 第二页 ======= */
  .transition-spacer { height: 40vh; }
  .info-section { min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 40px 40px 100px; }
  .content-block { max-width: 1000px; width: 100%; transform: translateZ(0); will-change: transform, opacity; }
  .section-title { font-family: 'Playfair Display', serif; font-size: 14px; letter-spacing: 0.3em; font-weight: 400; color: #888; text-align: center; margin-bottom: 80px; }
  .roles-grid { display: grid; grid-template-columns: 1fr; gap: 60px; text-align: center; }
  @media (min-width: 768px) { .roles-grid { grid-template-columns: repeat(3, 1fr); } }
  .role-item h3 { font-family: 'Playfair Display', serif; font-size: 24px; font-style: italic; font-weight: 400; margin: 0 0 10px; color: #fff; }
  .role-item p { font-size: 11px; color: #777; letter-spacing: 0.1em; margin: 0; }
  .action-area { text-align: center; margin-top: 100px; }
  
  /* 移除按钮的 backdrop-filter */
  .contact-btn { display: inline-block; font-size: 13px; color: #fff; text-decoration: none; letter-spacing: 0.2em; border: 1px solid #444; padding: 20px 60px; background: rgba(20,20,20,0.8); transition: background 0.4s ease, border-color 0.4s ease; }
  .contact-btn:hover { background: #fff; color: #000; border-color: #fff; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollLock = document.getElementById('scroll-lock');
    const bgs = document.querySelectorAll('.bg-image');
    const heroTitle = document.getElementById('hero-title');
    const infoContent = document.getElementById('info-content');
    
    let currentIndex = 0;
    setInterval(() => {
      bgs[currentIndex].classList.remove('active');
      bgs[currentIndex].style.zIndex = '0';
      currentIndex = (currentIndex + 1) % bgs.length;
      const newBg = bgs[currentIndex];
      newBg.style.zIndex = '1';
      newBg.classList.add('active');
    }, 5000);

    // 纯 CSS 雾化代替了高负载 WebGL。JS 只处理最轻量的透明度淡出。
    let ticking = false;
    scrollLock.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = scrollLock.scrollTop;
          const windowHeight = window.innerHeight;

          // 第一屏文字：不做位移，只做透明度渐变，彻底根绝抖动
          if (scrollY <= windowHeight) {
            const heroProg = scrollY / windowHeight;
            // 强制取整对齐像素，防止亚像素颤动
            heroTitle.style.opacity = Math.max(0, 1 - heroProg);
          }

          // 第二屏文字：强制像素取整
          const distance = infoContent.getBoundingClientRect().top;
          if (distance < windowHeight && distance > -300) {
            const infoProg = Math.max(0, Math.min(1, 1 - (distance / windowHeight)));
            infoContent.style.opacity = infoProg;
            // 取整，消灭微震
            const translateY = Math.round((1 - infoProg) * 60);
            infoContent.style.transform = `translate3d(0, ${translateY}px, 0)`;
          } else if (distance <= -300) {
            infoContent.style.opacity = 1;
            infoContent.style.transform = `translate3d(0, 0, 0)`;
          }

          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  });
</script>
