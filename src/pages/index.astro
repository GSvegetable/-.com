---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="The Blank Front Page">
  
  <div class="scroll-lock" id="scroll-lock">
    <div class="scroll-content" id="scroll-content">
      
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Noto+Serif+SC:wght@300;400&family=Playfair+Display:ital,wght@0,400;1,400&display=swap" rel="stylesheet">

      <!-- 背景层 -->
      <div class="fixed-bg" id="bg-container">
        <div class="bg-image active" style="background-image: url('/bg1.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg2.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg3.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg4.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg5.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg6.jpg')"></div>
        <div class="fog-overlay"></div>
        <div class="vignette"></div>
      </div>

      <div class="content-wrapper">
        
        <!-- 第一页：使用 sticky 钉在视口中 -->
        <section class="hero-section">
          <div class="newspaper-masthead" id="hero-title">
            <div class="masthead-top mono">
              <span>VOL. I</span>
              <span>LONDON GAZETTE</span>
              <span>EST. 1888</span>
            </div>

            <div class="letter-body">
              <p class="script-text indent-1">To the Esteemed Visionaries,</p>
              <p class="script-text indent-2">The Foggy Streets of London.</p>
              
              <p class="script-text mt-3">Dear Partner,</p>
              <p class="script-text">The year is 1888. The city drowns in mist, and mysteries unfold in the gaslight.</p>
              <p class="script-text">We are crafting a grand illusion (Unreal Engine 5), a world of shadows and truth.</p>
              <p class="script-text">We seek the Architects, the Illustrators, and the Chroniclers.</p>
              
              <p class="script-text mt-3">Should you wish to join our secret endeavour, leave your mark.</p>
              
              <p class="script-text indent-3 mt-3">Yours in the mist,</p>
              <p class="script-text indent-3 signature">Gong Shui.</p>

              <!-- 中文注脚 -->
              <div class="cn-annotation">
                <p>致尊敬的远见者：</p>
                <p>1888年，伦敦深陷迷雾，真相在煤气灯下交织。我们正用虚幻引擎5构筑这个世界，寻找代码工匠、光影画师与叙事记录者。若你愿加入这场秘密行动，请留下你的线索。</p>
              </div>
            </div>

            <div class="masthead-bottom mono">
              <div class="line"></div>
              <span>CONFIDENTIAL / SEEKING PARTNERS</span>
              <div class="line"></div>
            </div>
          </div>
        </section>

        <!-- 第二页：带有锯齿边缘，像深渊一样吞噬上来 -->
        <section class="info-section" id="info-section">
          <div class="content-block" id="info-content">
            <h2 class="section-title">SEEKING PARTNERS</h2>
            <div class="roles-grid">
              <div class="role-item"><h3>UE5 / C++</h3><p>SYSTEM ARCHITECTURE</p></div>
              <div class="role-item"><h3>3D / LIGHTING</h3><p>ENVIRONMENT ART</p></div>
              <div class="role-item"><h3>NARRATIVE</h3><p>STORY & MECHANICS</p></div>
            </div>
            <div class="action-area">
              <a href="mailto:hi@gongshui.com" class="contact-btn mono">[ INITIATE CONTACT ]</a>
            </div>
          </div>
        </section>
        
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  :global(body) {
    margin: 0; padding: 0;
    overflow: hidden;
    background-color: #030303;
    color: #e8e8e8;
    -webkit-font-smoothing: antialiased;
  }
  .mono { font-family: 'Courier New', Courier, monospace; }

  .scroll-lock {
    position: fixed; inset: 0;
    overflow-y: auto; overflow-x: hidden;
    scrollbar-width: none; -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch; 
  }
  .scroll-lock::-webkit-scrollbar { display: none; }
  .scroll-content { position: relative; }

  /* 背景层 */
  .fixed-bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
  .bg-image {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
    background-size: cover; background-position: center;
    filter: grayscale(100%) contrast(130%) brightness(0.2);
    opacity: 0;
    transition: opacity 3s ease-in-out; 
  }
  .bg-image.active { opacity: 1; z-index: 1; }
  .fog-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(3,3,3,0.1) 0%, rgba(3,3,3,0.85) 60%, #030303 100%);
    pointer-events: none; z-index: 2;
  }
  .vignette {
    position: absolute; inset: 0;
    background: radial-gradient(circle at 50% 30%, transparent 10%, #030303 90%);
    pointer-events: none; z-index: 3;
  }

  .content-wrapper { position: relative; z-index: 4; }
  
  /* ======= 第一页 ======= */
  .hero-section { 
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex; 
    align-items: center; 
    justify-content: center; 
    padding: 40px;
    /* 取消 JS 控制，它现在是被吃掉的那一层 */
  }

  .newspaper-masthead {
    width: 100%; max-width: 900px;
    display: flex; flex-direction: column;
    transform: translateZ(0);
  }

  /* 顶部细线框架 */
  .masthead-top {
    display: flex; justify-content: space-between;
    border-top: 1px solid rgba(255,255,255,0.2);
    border-bottom: 1px solid rgba(255,255,255,0.2);
    padding: 12px 0;
    font-size: 11px; letter-spacing: 0.2em; color: #888;
  }

  /* 信件核心内容区：排版紧凑化 */
  .letter-body {
    padding: 40px 0 30px 0;
    display: flex;
    flex-direction: column;
  }

  .script-text {
    font-family: 'Pinyon Script', cursive;
    font-size: clamp(28px, 3.5vw, 42px);
    line-height: 1.3;
    color: #f4eee0; 
    margin: 0 0 8px 0;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.8), 0 0 15px rgba(244,238,224,0.1);
  }

  .indent-1 { margin-left: 5vw; }
  .indent-2 { margin-left: 12vw; font-size: clamp(22px, 2.8vw, 32px); color: #c2b8a6; }
  .indent-3 { margin-left: 20vw; }
  .mt-3 { margin-top: 24px; }

  .signature {
    font-size: clamp(40px, 5vw, 56px);
    color: #d1c5b4;
    transform: rotate(-3deg);
    display: inline-block;
    margin-top: -10px;
  }

  /* 中文注脚 */
  .cn-annotation {
    margin-top: 30px;
    padding-top: 16px;
    border-top: 1px dashed rgba(255,255,255,0.1);
    max-width: 600px;
    margin-left: auto;
    text-align: right;
  }
  .cn-annotation p {
    font-family: 'Noto Serif SC', serif;
    font-size: 13px;
    line-height: 1.8;
    color: #777;
    margin: 0 0 4px 0;
  }

  /* 底部细线框架 */
  .masthead-bottom {
    display: flex; align-items: center; gap: 20px;
    margin-top: 10px;
  }
  .masthead-bottom .line { flex: 1; height: 1px; background: rgba(255,255,255,0.2); }
  .masthead-bottom span { font-size: 10px; letter-spacing: 0.3em; color: #666; }

  /* ======= 第二页：吞噬层 ======= */
  .info-section { 
    position: relative;
    /* 背景设为纯黑，完全遮挡下面 */
    background-color: #050505;
    /* 关键：给顶部做出不规则的锯齿边缘，模拟被撕裂/吞噬的物理感 */
    clip-path: polygon(
      0 4%, 5% 0, 12% 5%, 20% 1%, 28% 6%, 35% 2%, 45% 7%, 55% 0, 65% 5%, 75% 1%, 85% 6%, 95% 2%, 100% 5%, 
      100% 100%, 0 100%
    );
    margin-top: -10vh; /* 把第二页往上拉，和第一页产生咬合 */
    padding: 15vh 40px 100px;
    display: flex; 
    align-items: center; 
    justify-content: center;
    z-index: 10;
    /* 添加阴影让锯齿边缘更立体 */
    box-shadow: 0 -20px 50px rgba(0,0,0,0.9);
  }

  .content-block { 
    max-width: 1000px; width: 100%; 
    transform: translateZ(0);
  }
  
  .section-title { font-family: 'Playfair Display', serif; font-size: 14px; letter-spacing: 0.3em; font-weight: 400; color: #888; text-align: center; margin-bottom: 60px; }
  .roles-grid { display: grid; grid-template-columns: 1fr; gap: 60px; text-align: center; }
  @media (min-width: 768px) { .roles-grid { grid-template-columns: repeat(3, 1fr); } }
  .role-item h3 { font-family: 'Playfair Display', serif; font-size: 24px; font-style: italic; font-weight: 400; margin: 0 0 10px; color: #fff; }
  .role-item p { font-size: 11px; color: #777; letter-spacing: 0.1em; margin: 0; }
  .action-area { text-align: center; margin-top: 80px; }
  .contact-btn { display: inline-block; font-size: 13px; color: #fff; text-decoration: none; letter-spacing: 0.2em; border: 1px solid #444; padding: 20px 60px; background: rgba(20,20,20,0.8); transition: background 0.4s ease, border-color 0.4s ease; }
  .contact-btn:hover { background: #fff; color: #000; border-color: #fff; }

  /* 适配手机 */
  @media (max-width: 600px) {
    .letter-body { padding: 20px 0; }
    .script-text { font-size: 24px; }
    .indent-1 { margin-left: 0; }
    .indent-2 { margin-left: 10vw; font-size: 20px; }
    .indent-3 { margin-left: 10vw; }
    .cn-annotation { text-align: left; }
    .info-section { padding: 20vh 20px 80px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const bgs = document.querySelectorAll('.bg-image');
    let currentIndex = 0;
    // 背景轮播不变
    setInterval(() => {
      bgs[currentIndex].classList.remove('active');
      bgs[currentIndex].style.zIndex = '0';
      currentIndex = (currentIndex + 1) % bgs.length;
      const newBg = bgs[currentIndex];
      newBg.style.zIndex = '1';
      newBg.classList.add('active');
    }, 5000);
  });
</script>
