---
// 原生 Web Component 方案
import 'simple-liquid-glass/web-component';
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>宫水.com</title>
  </head>
  <body>
    <div class="bg-text-bg">MIYAMIZU</div>

    <!-- 直接使用自定义标签，无需写任何初始化 JS -->
    <liquid-glass radius="32" frost="0.15" blur="8" saturation="150" style="width: 400px; height: 220px; display: block; position: relative; z-index: 2;">
      <div class="glass-content">
        <h1>懒得做了</h1>
        <p>但域名都买了，凑合看吧</p>
      </div>
    </liquid-glass>
  </body>
</html>

<style>
  html, body {
    margin: 0;
    padding: 0;
    height: 100vh;
    overflow: hidden;
    background-color: #050505;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .bg-text-bg {
    position: absolute;
    font-size: 15vw;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.08);
    letter-spacing: 0.2em;
    user-select: none;
    z-index: 0;
  }

  .glass-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    text-align: center;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 0.8rem 0;
    color: #fff;
    letter-spacing: 0.1em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    letter-spacing: 0.05em;
  }
</style>
