---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="The Blank Front Page">
  
  <div class="scroll-lock" id="scroll-lock">
    <div class="scroll-content" id="scroll-content">
      
      <!-- 引入极致花体字和复古衬线字 -->
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Noto+Serif+SC:wght@300;400&family=Playfair+Display:ital,wght@0,400;1,400&display=swap" rel="stylesheet">

      <!-- 轮播背景层 -->
      <div class="fixed-bg" id="bg-container">
        <div class="bg-image active" style="background-image: url('/bg1.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg2.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg3.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg4.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg5.jpg')"></div>
        <div class="bg-image" style="background-image: url('/bg6.jpg')"></div>
        <div class="fog-overlay"></div>
        <div class="vignette"></div>
      </div>

      <div class="content-wrapper">
        <!-- 第一页：英伦信纸 -->
        <section class="hero-section">
          <div class="letter-wrapper" id="hero-title">
            
            <!-- 信纸本体 -->
            <div class="letter-paper">
              
              <!-- 右上角邮票与邮戳 -->
              <div class="stamp-area">
                <div class="postmark">
                  <svg viewBox="0 0 100 100">
                    <circle cx="50" cy="50" r="45" fill="none" stroke="#222" stroke-width="2" stroke-dasharray="4 2"/>
                    <circle cx="50" cy="50" r="35" fill="none" stroke="#222" stroke-width="1"/>
                    <text x="50" y="45" font-family="sans-serif" font-size="10" text-anchor="middle" fill="#222">LONDON</text>
                    <text x="50" y="60" font-family="sans-serif" font-size="8" text-anchor="middle" fill="#222">OC 21 · 88</text>
                  </svg>
                </div>
                <div class="stamp">
                  <div class="stamp-inner">
                    <span class="stamp-value">1d</span>
                    <svg class="queen-silhouette" viewBox="0 0 50 60">
                      <path d="M25,5 C15,5 10,15 10,25 C10,40 20,55 25,55 C30,55 40,40 40,25 C40,15 35,5 25,5 Z" fill="#222" opacity="0.6"/>
                    </svg>
                  </div>
                </div>
              </div>

              <!-- 信件正文排版 -->
              <div class="letter-content">
                <p class="salutation">To the Esteemed Visionaries,</p>
                <p class="address-step">The Foggy Streets of London.</p>
                
                <p class="body-text">Dear Partner,</p>
                <p class="body-text">The year is 1888. The city drowns in mist, and mysteries unfold in the gaslight.</p>
                <p class="body-text">We are crafting a grand illusion (Unreal Engine 5), a world of shadows and truth.</p>
                <p class="body-text">We seek the Architects, the Illustrators, and the Chroniclers.</p>
                <p class="body-text">Should you wish to join our secret endeavour, leave your mark.</p>
                
                <p class="sign-off">Yours in the mist,</p>
                <p class="signature">Gong Shui.</p>

                <!-- 中文注脚 -->
                <div class="cn-annotation">
                  <p>致尊敬的远见者：</p>
                  <p>1888年，伦敦深陷迷雾，真相在煤气灯下交织。我们正用虚幻引擎5构筑这个世界，寻找代码工匠、光影画师与叙事记录者。若你愿加入这场秘密行动，请留下你的线索。</p>
                </div>
              </div>

              <!-- 右下角火漆印章 -->
              <div class="wax-seal">
                <div class="seal-inner">G</div>
              </div>

            </div>
          </div>
        </section>

        <div class="transition-spacer"></div>

        <!-- 第二页：招募内容 -->
        <section class="info-section" id="info-section">
          <div class="content-block" id="info-content">
            <h2 class="section-title">SEEKING PARTNERS</h2>
            <div class="roles-grid">
              <div class="role-item"><h3>UE5 / C++</h3><p>SYSTEM ARCHITECTURE</p></div>
              <div class="role-item"><h3>3D / LIGHTING</h3><p>ENVIRONMENT ART</p></div>
              <div class="role-item"><h3>NARRATIVE</h3><p>STORY & MECHANICS</p></div>
            </div>
            <div class="action-area">
              <a href="mailto:hi@gongshui.com" class="contact-btn mono">[ INITIATE CONTACT ]</a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  :global(body) {
    margin: 0; padding: 0;
    overflow: hidden;
    background-color: #030303;
    color: #e8e8e8;
    -webkit-font-smoothing: antialiased;
  }
  .mono { font-family: 'Courier New', Courier, monospace; }

  /* 隐藏滚动条，保持极致顺滑 */
  .scroll-lock {
    position: fixed; inset: 0;
    overflow-y: auto; overflow-x: hidden;
    scrollbar-width: none; -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch; 
  }
  .scroll-lock::-webkit-scrollbar { display: none; }
  .scroll-content { position: relative; }

  /* 背景层 */
  .fixed-bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
  .bg-image {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
    background-size: cover; background-position: center;
    filter: grayscale(100%) contrast(130%) brightness(0.2);
    opacity: 0;
    transition: opacity 3s ease-in-out; 
  }
  .bg-image.active { opacity: 1; z-index: 1; }
  .fog-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(3,3,3,0.1) 0%, rgba(3,3,3,0.8) 60%, #030303 100%);
    pointer-events: none; z-index: 2;
  }
  .vignette {
    position: absolute; inset: 0;
    background: radial-gradient(circle at 50% 30%, transparent 10%, #030303 90%);
    pointer-events: none; z-index: 3;
  }

  .content-wrapper { position: relative; z-index: 4; }
  
  /* ======= 第一页：信件区域 ======= */
  .hero-section { 
    min-height: 100vh; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    padding: 40px 20px;
  }

  .letter-wrapper {
    width: 100%; max-width: 800px;
    transform: translateZ(0);
    will-change: opacity, transform;
  }

  /* 信纸物理质感：羊皮纸底色、边缘阴影、高光 */
  .letter-paper {
    position: relative;
    background-color: #e8e2d2; /* 泛黄纸张底色 */
    /* 模拟纸张老化渐变 */
    background-image: radial-gradient(circle at 50% 0%, #f4eedc 0%, #e8e2d2 60%, #d8d0bc 100%);
    box-shadow: 
      0 20px 50px rgba(0,0,0,0.6), /* 外部宏观投影 */
      inset 0 0 40px rgba(100, 90, 70, 0.15), /* 内部纸张纤维暗角 */
      inset 0 0 5px rgba(255,255,255,0.8); /* 边缘高光 */
    padding: 60px 50px;
    border-radius: 2px;
    /* 微微倾斜，增加随意感 */
    transform: rotate(-1.5deg);
  }

  /* 邮票与邮戳 */
  .stamp-area {
    position: absolute;
    top: 30px; right: 30px;
    display: flex; align-items: center;
  }

  .postmark {
    width: 80px; height: 80px;
    transform: rotate(-15deg);
    margin-right: -20px;
    opacity: 0.6;
    /* 模拟油墨渗透 */
    mix-blend-mode: multiply; 
  }

  .stamp {
    width: 60px; height: 75px;
    background: #c5b9a5;
    /* 邮票齿孔效果 */
    background-image: radial-gradient(circle, transparent 40%, #e8e2d2 45%);
    background-size: 8px 8px;
    background-position: -4px -4px;
    border: 1px solid #b0a590;
    box-shadow: 1px 2px 4px rgba(0,0,0,0.3);
    display: flex; align-items: center; justify-content: center;
    position: relative;
  }
  .stamp-inner {
    width: 50px; height: 65px;
    border: 1px solid #8c7e69;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: #d6ccb8;
  }
  .stamp-value {
    font-family: 'Playfair Display', serif;
    font-size: 14px; font-weight: bold; color: #222;
  }
  .queen-silhouette { width: 24px; height: 30px; margin-top: 4px; }

  /* 信件正文排版 */
  .letter-content {
    color: #1a1816;
    max-width: 90%;
  }

  .salutation {
    font-family: 'Pinyon Script', cursive;
    font-size: 32px;
    margin: 0 0 10px 0;
  }

  .address-step {
    font-family: 'Playfair Display', serif;
    font-size: 15px;
    font-style: italic;
    margin: 0 0 40px 40px; /* 阶梯缩进 */
    color: #4a453d;
  }

  .body-text {
    font-family: 'Pinyon Script', cursive;
    font-size: 28px;
    line-height: 1.4;
    margin: 0 0 15px 0;
    /* 增加墨水在纸上的渗透感 */
    text-shadow: 0.5px 0.5px 0px rgba(0,0,0,0.1);
  }

  .sign-off {
    font-family: 'Pinyon Script', cursive;
    font-size: 28px;
    margin: 40px 0 0 0;
  }

  .signature {
    font-family: 'Pinyon Script', cursive;
    font-size: 36px;
    margin: 0;
    transform: rotate(-2deg);
    display: inline-block;
  }

  /* 中文注脚 */
  .cn-annotation {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px dashed rgba(0,0,0,0.2);
  }
  .cn-annotation p {
    font-family: 'Noto Serif SC', serif;
    font-size: 13px;
    line-height: 1.8;
    color: #5c564d;
    margin: 0 0 6px 0;
  }

  /* 右下角火漆印章 */
  .wax-seal {
    position: absolute;
    bottom: -20px; right: 40px;
    width: 90px; height: 90px;
    border-radius: 50%;
    /* 多层渐变和阴影模拟火漆的融化与高光 */
    background: radial-gradient(circle at 35% 35%, #a82e2e 0%, #7a1515 40%, #4a0808 100%);
    box-shadow: 
      3px 5px 15px rgba(0,0,0,0.5),
      inset 2px 2px 5px rgba(255,255,255,0.2),
      inset -3px -3px 8px rgba(0,0,0,0.6);
    display: flex; align-items: center; justify-content: center;
    transform: rotate(10deg);
  }
  .seal-inner {
    width: 70px; height: 70px;
    border-radius: 50%;
    border: 2px dashed rgba(255,255,255,0.15);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Playfair Display', serif;
    font-size: 32px; font-weight: 700; color: #d19a9a;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
  }

  /* ======= 第二页 ======= */
  .transition-spacer { height: 30vh; }
  .info-section { min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 40px 40px 100px; }
  .content-block { max-width: 1000px; width: 100%; transform: translateZ(0); will-change: transform, opacity; }
  .section-title { font-family: 'Playfair Display', serif; font-size: 14px; letter-spacing: 0.3em; font-weight: 400; color: #888; text-align: center; margin-bottom: 80px; }
  .roles-grid { display: grid; grid-template-columns: 1fr; gap: 60px; text-align: center; }
  @media (min-width: 768px) { .roles-grid { grid-template-columns: repeat(3, 1fr); } }
  .role-item h3 { font-family: 'Playfair Display', serif; font-size: 24px; font-style: italic; font-weight: 400; margin: 0 0 10px; color: #fff; }
  .role-item p { font-size: 11px; color: #777; letter-spacing: 0.1em; margin: 0; }
  .action-area { text-align: center; margin-top: 100px; }
  .contact-btn { display: inline-block; font-size: 13px; color: #fff; text-decoration: none; letter-spacing: 0.2em; border: 1px solid #444; padding: 20px 60px; background: rgba(20,20,20,0.8); transition: background 0.4s ease, border-color 0.4s ease; }
  .contact-btn:hover { background: #fff; color: #000; border-color: #fff; }

  /* 适配平板手机尺寸 */
  @media (max-width: 600px) {
    .letter-paper { padding: 40px 20px; transform: rotate(0deg); }
    .stamp-area { top: 15px; right: 15px; transform: scale(0.8); }
    .letter-content { max-width: 100%; }
    .salutation { font-size: 24px; }
    .body-text { font-size: 22px; }
    .signature { font-size: 28px; }
    .address-step { margin-left: 20px; }
    .wax-seal { right: 20px; width: 70px; height: 70px; }
    .seal-inner { width: 54px; height: 54px; font-size: 24px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollLock = document.getElementById('scroll-lock');
    const bgs = document.querySelectorAll('.bg-image');
    const heroTitle = document.getElementById('hero-title');
    const infoContent = document.getElementById('info-content');
    
    let currentIndex = 0;
    setInterval(() => {
      bgs[currentIndex].classList.remove('active');
      bgs[currentIndex].style.zIndex = '0';
      currentIndex = (currentIndex + 1) % bgs.length;
      const newBg = bgs[currentIndex];
      newBg.style.zIndex = '1';
      newBg.classList.add('active');
    }, 5000);

    // 依然保持顺滑的像素取整和淡出
    let ticking = false;
    scrollLock.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = scrollLock.scrollTop;
          const windowHeight = window.innerHeight;

          if (scrollY <= windowHeight) {
            const heroProg = scrollY / windowHeight;
            // 信纸在滑动时往上飘走并淡出
            heroTitle.style.opacity = Math.max(0, 1 - heroProg * 1.5);
            heroTitle.style.transform = `translate3d(0, ${-scrollY * 0.2}px, 0)`;
          }

          const distance = infoContent.getBoundingClientRect().top;
          if (distance < windowHeight && distance > -300) {
            const infoProg = Math.max(0, Math.min(1, 1 - (distance / windowHeight)));
            infoContent.style.opacity = infoProg;
            const translateY = Math.round((1 - infoProg) * 60);
            infoContent.style.transform = `translate3d(0, ${translateY}px, 0)`;
          } else if (distance <= -300) {
            infoContent.style.opacity = 1;
            infoContent.style.transform = `translate3d(0, 0, 0)`;
          }

          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  });
</script>
