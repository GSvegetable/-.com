---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="The Blank Front Page">
  
  <!-- 纯粹的浓雾与光影底层 -->
  <div class="fog-bg"></div>

  <!-- 悬浮的年代物件层 -->
  <div class="objects-layer" id="objects-layer">
    <!-- 大本钟 (远景，慢速，大) -->
    <div class="object obj-bigben" data-speed="0.1">
      <img src="https://www.pngarts.com/files/3/Big-Ben-PNG-Image-Background.png" alt="Big Ben" />
    </div>

    <!-- 马车 (中景，中速) -->
    <div class="object obj-carriage" data-speed="0.3">
      <img src="https://clipart-library.com/images_k/horse-carriage-silhouette/horse-carriage-silhouette-22.png" alt="Carriage" />
    </div>

    <!-- 维多利亚女士 (中景) -->
    <div class="object obj-lady" data-speed="0.35">
      <img src="https://clipart-library.com/images_k/victorian-silhouette/victorian-silhouette-11.png" alt="Victorian Lady" />
    </div>

    <!-- 煤气灯 (近景，快速) -->
    <div class="object obj-gaslight" data-speed="0.5">
      <img src="https://publicdomainvectors.org/photos/gas-lamp-silhouette.png" alt="Gaslight" />
    </div>

    <!-- 怀表 (近景) -->
    <div class="object obj-watch" data-speed="0.7">
      <img src="https://clipart-library.com/images_k/pocket-watch-silhouette/pocket-watch-silhouette-25.png" alt="Pocket Watch" />
    </div>

    <!-- 羽毛笔 (极近景，最快) -->
    <div class="object obj-quill" data-speed="0.9">
      <img src="https://clipart-library.com/images_k/feather-pen-silhouette/feather-pen-silhouette-13.png" alt="Feather Quill" />
    </div>
  </div>

  <!-- 内容层 -->
  <div class="content-wrapper">
    <section class="hero-section">
      <div class="title-container">
        <div class="sub-title mono">EST. 1888 · LONDON</div>
        
        <h1 class="victorian-title">
          <span class="line-small">The</span>
          <!-- 血溅特效 -->
          <span class="line-huge blood-splatter" data-text="Blank">Blank</span>
          <span class="line-medium">Front Page</span>
        </h1>

        <div class="vertical-line"></div>
      </div>
    </section>

    <section class="info-section">
      <div class="content-block">
        <h2 class="section-title">SEEKING PARTNERS</h2>
        <div class="roles-grid">
          <div class="role-item"><h3>UE5 / C++</h3><p>SYSTEM ARCHITECTURE</p></div>
          <div class="role-item"><h3>3D / LIGHTING</h3><p>ENVIRONMENT ART</p></div>
          <div class="role-item"><h3>NARRATIVE</h3><p>STORY & MECHANICS</p></div>
        </div>
        <div class="action-area">
          <a href="mailto:hi@gongshui.com" class="contact-btn mono">[ INITIATE CONTACT ]</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(body) {
    background-color: #060606;
    color: #e8e8e8;
    margin: 0; padding: 0;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  .mono { font-family: 'Courier New', Courier, monospace; }

  .fog-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: radial-gradient(circle at 50% 30%, rgba(30, 25, 20, 0.6) 0%, #060606 70%);
    pointer-events: none;
  }

  .objects-layer {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .object {
    position: absolute;
    will-change: transform, opacity;
  }

  .object img {
    width: 100%;
    height: auto;
    /* 将图片变成纯黑剪影，并做一点模糊模拟景深 */
    filter: brightness(0) contrast(100%) blur(1px);
  }

  /* 精确布局：错落有致地分布在屏幕各处 */
  .obj-bigben { left: 5vw; top: 15vh; width: clamp(80px, 12vw, 180px); opacity: 0.15; }
  .obj-carriage { right: 10vw; top: 50vh; width: clamp(120px, 18vw, 250px); opacity: 0.2; }
  .obj-lady { left: 20vw; top: 70vh; width: clamp(60px, 9vw, 120px); opacity: 0.25; }
  .obj-gaslight { right: 25vw; top: 20vh; width: clamp(70px, 10vw, 140px); opacity: 0.4; }
  .obj-watch { left: 40vw; top: 40vh; width: clamp(50px, 7vw, 90px); opacity: 0.5; }
  .obj-quill { right: 15vw; top: 75vh; width: clamp(40px, 6vw, 80px); opacity: 0.6; }

  /* 内容层 */
  .content-wrapper {
    position: relative;
    z-index: 2;
  }

  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .title-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sub-title {
    font-size: 11px;
    letter-spacing: 0.4em;
    color: #888;
    margin-bottom: 40px;
  }

  .victorian-title {
    font-family: 'Playfair Display', serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    line-height: 0.9;
  }

  .line-small {
    font-size: clamp(28px, 5vw, 56px);
    font-style: italic;
    font-weight: 400;
    color: #a0a0a0;
    transform: translateX(-15vw);
  }

  .line-medium {
    font-size: clamp(32px, 7vw, 80px);
    font-style: italic;
    font-weight: 400;
    color: #d1c5b4;
    letter-spacing: 0.08em;
    transform: translateX(10vw);
  }

  .line-huge {
    position: relative;
    font-size: clamp(80px, 20vw, 240px);
    font-style: italic;
    font-weight: 400;
    color: #fff;
    letter-spacing: -0.01em;
    text-shadow: 0 10px 30px rgba(0,0,0,0.8);
    margin: -1vh 0;
  }

  .blood-splatter {
    position: relative;
    display: inline-block;
  }

  .blood-splatter::after {
    content: attr(data-text);
    position: absolute;
    left: 0; top: 0;
    z-index: -1;
    color: transparent;
    background-image: 
      radial-gradient(circle at 85% 15%, #9c0505 0%, #5a0000 25%, transparent 60%),
      radial-gradient(circle at 70% 10%, #8a0303 3%, transparent 10%),
      radial-gradient(circle at 95% 40%, #6b0000 2%, transparent 6%),
      radial-gradient(circle at 60% 20%, #9c0505 4%, transparent 12%);
    -webkit-background-clip: text;
    background-clip: text;
    opacity: 0;
    transform: scale(0.8) rotate(2deg);
    transform-origin: top right;
    animation: bloodSplat 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.5s forwards;
  }

  @keyframes bloodSplat {
    0% { opacity: 0; transform: scale(0.3) rotate(5deg); }
    60% { opacity: 1; transform: scale(1.05) rotate(-2deg); }
    100% { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  .vertical-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(180deg, #555, transparent);
    margin-top: 40px;
  }

  .info-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 40px;
    background: linear-gradient(180deg, transparent, #060606 20%);
  }

  .content-block { max-width: 1000px; width: 100%; }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: 14px;
    letter-spacing: 0.3em;
    font-weight: 400;
    color: #888;
    text-align: center;
    margin-bottom: 80px;
  }

  .roles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 60px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .roles-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .role-item h3 {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    font-style: italic;
    font-weight: 400;
    margin: 0 0 10px;
    color: #fff;
  }

  .role-item p {
    font-size: 11px;
    color: #777;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .action-area { text-align: center; margin-top: 100px; }

  .contact-btn {
    display: inline-block;
    font-size: 13px;
    color: #fff;
    text-decoration: none;
    letter-spacing: 0.2em;
    border: 1px solid #444;
    padding: 20px 60px;
    background: rgba(0,0,0,0.3);
    backdrop-filter: blur(5px);
    transition: all 0.4s ease;
  }

  .contact-btn:hover {
    background: #fff;
    color: #000;
    border-color: #fff;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const objects = document.querySelectorAll('.object');
    
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      
      objects.forEach(obj => {
        const speed = parseFloat(obj.getAttribute('data-speed'));
        const yPos = -(scrollY * speed);
        
        let opacity = 1 - (scrollY / 600);
        if (opacity < 0) opacity = 0;
        
        const baseOpacity = obj.classList.contains('obj-bigben') ? 0.15 : 
                            obj.classList.contains('obj-carriage') ? 0.2 :
                            obj.classList.contains('obj-lady') ? 0.25 :
                            obj.classList.contains('obj-gaslight') ? 0.4 :
                            obj.classList.contains('obj-watch') ? 0.5 : 0.6;
                            
        obj.style.transform = `translateY(${yPos}px)`;
        obj.style.opacity = opacity * baseOpacity;
      });
    }, { passive: true });
  });
</script>
