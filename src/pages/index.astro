---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="The Blank Front Page">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">

  <div class="debug-progress mono" id="progress-indicator">0%</div>

  <div class="fog" aria-hidden="true">
    <div class="fog-layer fog-a" id="fog-a"></div>
    <div class="fog-layer fog-b" id="fog-b"></div>
  </div>

  <section class="hero-section">
    <div class="perspective-wrap">
      <div class="hero-stage" id="hero-masthead" style="transform: translate3d(0, -10vh, 0) rotateX(0deg) scaleY(1);">
        <div class="bg-layer">
          <div class="bg-image active" style="background-image: url('/bg1.jpg')"></div>
          <div class="bg-image" style="background-image: url('/bg2.jpg')"></div>
          <div class="bg-image" style="background-image: url('/bg3.jpg')"></div>
          <div class="bg-image" style="background-image: url('/bg4.jpg')"></div>
          <div class="bg-image" style="background-image: url('/bg5.jpg')"></div>
          <div class="bg-image" style="background-image: url('/bg6.jpg')"></div>
        </div>
        <div class="newspaper-masthead">
          <div class="masthead-top mono">
            <span>VOL. I</span>
            <span>LONDON GAZETTE</span>
            <span>EST. 1888</span>
          </div>
          <div class="letter-body">
            <div class="header-group">
              <p class="salutation">To the Esteemed Visionaries,</p>
            </div>
            <div class="content-group">
              <p class="greeting">Dear Partner,</p>
              <p class="body-text">
                The year is <span class="highlight">1888</span>. The city drowns in mist, and mysteries unfold in the gaslight. We are crafting a grand illusion <span class="highlight">(Unreal Engine 5)</span>, a world of shadows and truth. 
              </p>
              <p class="body-text">
                We seek the Architects, the Illustrators, and the Chroniclers. We welcome you in <span class="highlight">London</span>, <span class="highlight">Shanghai</span>, and <span class="highlight">Toronto</span>.
              </p>
            </div>
            <div class="signature-group">
              <p class="sign-off">Yours in the mist,</p>
              <p class="signature ink-break">Gong Shui.</p>
            </div>
          </div>
        </div>
        <div class="fade-mask" id="fade-mask"></div>
      </div>
    </div>
  </section>

  <div class="scroll-spacer"></div>

  <section class="info-section" id="info-section">
    <div class="content-block">
      <div class="roles-grid" id="roles-grid">
        <div class="role-item"><h3>UE5 / C++</h3><p>SYSTEM ARCHITECTURE</p></div>
        <div class="role-item"><h3>3D / LIGHTING</h3><p>ENVIRONMENT ART</p></div>
        <div class="role-item"><h3>NARRATIVE</h3><p>STORY & MECHANICS</p></div>
      </div>
      <div class="action-area" id="action-area">
        <div class="contact-btn" role="button">
          <span class="btn-text">CRIME SCENE</span>
        </div>
      </div>
    </div>
    <div class="info-dim" id="info-dim"></div>
  </section>

  <div class="p2-dwell" id="p2-dwell"></div>

  <!-- 将原来 400vh 改为 500vh，拉长滑动距离 -->
  <section class="page-three" id="page-three" aria-label="Case files">
    <div class="p3-stage" id="p3-stage">
      <div class="p3-lantern" id="p3-lantern"></div>

      <div class="p3-inner">
        <header class="p3-mast mono">
          <span>NO. 001</span>
          <span>THE BLANK FRONT PAGE</span>
          <span>ONE PENNY</span>
        </header>

        <div class="p3-cases">
          <article class="case case--intro">
            <h2 class="intro-title serif">
              <span class="line"><span style="--i:1">The truth is</span></span>
              <span class="line"><span style="--i:2">buried in the mist.</span></span>
            </h2>
            
            <div class="handwritten-area reveal" style="--i:4">
              <p class="handwritten-text">Three files. One city. Open them in order.</p>
              <div class="handwritten-hint">
                <span>SCROLL TO OPEN</span>
                <svg viewBox="0 0 24 24" class="scribble-arrow" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v16m0 0l-6-6m6 6l6-6"/></svg>
              </div>
            </div>

          </article>

          <article class="case case--file">
            <div class="case-num serif" aria-hidden="true">I</div>
            <div class="case-text">
              <div class="case-header-group">
                <h3 class="case-title serif wipe" style="--i:1">The Penny-a-Liner</h3>
                <p class="case-sub serif reveal" style="--i:3">Paid by the line. Loyal to no paper.</p>
              </div>
              <i class="rule" style="--i:2"></i>
              <p class="case-body serif dropcap reveal" style="--i:4">He sells his words to many papers and belongs to none. He knows which editor will print what, and exactly where to send a story so that it blows up. A loophole in the newspaper system, not an employee of it.</p>
              <div class="stamp-art mono" style="--r:-8deg" aria-hidden="true">Freelance</div>
            </div>
          </article>

          <article class="case case--file">
            <div class="case-num serif" aria-hidden="true">II</div>
            <div class="case-text">
              <div class="case-header-group">
                <h3 class="case-title serif wipe" style="--i:1">The Maid</h3>
                <p class="case-sub serif reveal" style="--i:3">To high society, servants are air.</p>
              </div>
              <i class="rule" style="--i:2"></i>
              <p class="case-body serif dropcap reveal" style="--i:4">She sees what he cannot. She knows what normal looks like, so she knows the moment something is wrong, and her network of servants runs deeper than any newspaper's. She is his eyes. He is her voice.</p>
              <div class="stamp-art mono" style="--r:6deg" aria-hidden="true">Informant</div>
            </div>
          </article>

          <article class="case case--file">
            <div class="case-num serif" aria-hidden="true">III</div>
            <div class="case-text">
              <div class="case-header-group">
                <h3 class="case-title serif wipe" style="--i:1">The City</h3>
                <p class="case-sub serif reveal" style="--i:3">1888. Fog, gaslight, and a great many closed doors.</p>
              </div>
              <i class="rule" style="--i:2"></i>
              <p class="case-body serif dropcap reveal" style="--i:4">We are building it in Unreal Engine 5, from London, Shanghai and Toronto. The case is open, and it needs Architects, Illustrators and Chroniclers.</p>
              <div class="p3-sign reveal" style="--i:6">
                <p class="p3-sign-off serif">Yours in the mist,</p>
                <p class="p3-signature">Gong Shui.</p>
              </div>
              <div class="stamp-art mono" style="--r:-5deg" aria-hidden="true">Open</div>
            </div>
          </article>
        </div>

        <footer class="site-footer">
          <div class="footer-main">
            <div class="footer-brand">
              <span class="footer-logo serif">宫水</span>
              <p class="footer-tagline mono">THE BLANK FRONT PAGE · EST. 1888</p>
            </div>
          </div>
          <div class="footer-bottom">
            <span class="mono">© 2026 宫水工作室</span>
            <span class="mono">LONDON · SHANGHAI · TORONTO</span>
          </div>
        </footer>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(html) { overscroll-behavior-y: none; }
  :global(body) { margin: 0; padding: 0; background-color: #030303; color: #e8e8e8; -webkit-font-smoothing: antialiased; overflow-x: hidden; overscroll-behavior-y: none; }
  :global(::-webkit-scrollbar) { display: none; width: 0 !important; }
  .mono { font-family: 'Courier Prime', monospace; }
  .serif { font-family: 'Playfair Display', serif; }

  .debug-progress { position: fixed; top: 20px; right: 20px; color: #d4af37; font-size: 14px; z-index: 9999; background: rgba(0,0,0,0.5); padding: 4px 8px; border-radius: 4px; border: 1px solid rgba(212, 175, 55, 0.3); pointer-events: none; }

  .fog { position: fixed; inset: 0; z-index: 35; pointer-events: none; overflow: hidden; }
  .fog-layer { position: absolute; top: -10%; bottom: -10%; left: -60%; width: 220%; opacity: 0; will-change: transform, opacity; }
  .fog-a { background: radial-gradient(40% 55% at 22% 58%, rgba(220,214,200,0.50), transparent 70%), radial-gradient(35% 50% at 62% 40%, rgba(220,214,200,0.38), transparent 70%), radial-gradient(30% 45% at 90% 65%, rgba(220,214,200,0.42), transparent 70%); }
  .fog-b { background: radial-gradient(45% 50% at 40% 45%, rgba(190,186,176,0.40), transparent 70%), radial-gradient(35% 55% at 78% 62%, rgba(190,186,176,0.36), transparent 70%), radial-gradient(30% 45% at 8% 35%, rgba(190,186,176,0.34), transparent 70%); }

  .hero-section { position: fixed; inset: 0; height: 100vh; height: 100lvh; display: flex; align-items: center; justify-content: center; z-index: 10; overflow: hidden; pointer-events: none; }
  .perspective-wrap { perspective: 2500px; perspective-origin: 50% 0%; width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; }
  
  .hero-stage { 
    position: relative; width: 100%; max-width: 100%; height: 100vh; height: 100lvh; 
    display: flex; flex-direction: column; justify-content: center; padding: 0; 
    transform-origin: center bottom; will-change: transform, opacity; pointer-events: auto; 
    opacity: 0; transition: opacity 0.3s ease-out; 
  }
  .hero-stage.loaded { opacity: 1; }
  
  .bg-layer { position: absolute; inset: 0; z-index: 1; overflow: hidden; }
  
  .bg-image { 
    position: absolute; inset: 0; width: 100%; height: 100%; 
    background-size: cover; background-position: center; 
    filter: grayscale(100%) contrast(130%) brightness(0.35); 
    opacity: 0; 
    transform: scale(1); 
    transition: opacity 3s ease-in-out, transform 30s linear; 
  }
  .bg-image.active { 
    opacity: 1; 
    transform: scale(1.15); 
  }

  .fade-mask { position: absolute; inset: -30% 0 0 0; background: linear-gradient(to bottom, #030303 0%, transparent 60%); opacity: 0; pointer-events: none; z-index: 5; }
  
  .newspaper-masthead { 
    position: relative; z-index: 2; 
    width: 100%; max-width: 900px; 
    margin: 0 auto; padding: 0 40px; 
    display: flex; flex-direction: column; 
  }
  
  .masthead-top { display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.15); padding: 0 0 12px 0; font-size: 10px; letter-spacing: 0.3em; color: #aaa; margin-bottom: 30px; }
  .letter-body { padding: 20px 0; display: flex; flex-direction: column; position: relative; border-left: 1px solid rgba(255,255,255,0.15); padding-left: 30px; margin-left: 10px; margin-top: 10px; }
  .header-group { margin-bottom: 24px; }
  .salutation { font-family: 'Pinyon Script', cursive; font-size: clamp(40px, 5vw, 60px); color: #f4eee0; margin: 0; text-shadow: 1px 1px 2px rgba(0,0,0,0.8); }
  .content-group { max-width: 80%; }
  .greeting { font-family: 'Pinyon Script', cursive; font-size: 32px; color: #d1c5b4; margin: 0 0 16px 0; }
  .body-text { font-family: 'Playfair Display', serif; font-size: 16px; line-height: 1.8; color: #c4bcad; margin: 0 0 16px 0; text-align: justify; }
  .highlight { color: #d4af37; font-weight: 700; font-style: italic; }
  .signature-group { margin-top: 20px; }
  .sign-off { font-family: 'Playfair Display', serif; font-style: italic; font-size: 14px; color: #888; margin: 0; }
  .signature { font-family: 'Pinyon Script', cursive; font-size: clamp(50px, 6vw, 70px); color: #f4eee0; margin: 0; transform: rotate(-5deg); display: inline-block; text-shadow: 2px 2px 4px rgba(0,0,0,0.8); }
  .ink-break { -webkit-mask-image: radial-gradient(circle at 20% 50%, transparent 2px, black 3px), radial-gradient(circle at 45% 30%, transparent 1.5px, black 2.5px), radial-gradient(circle at 70% 70%, transparent 2.5px, black 3.5px), radial-gradient(circle at 85% 40%, transparent 1px, black 2px), radial-gradient(circle at 10% 80%, transparent 1.5px, black 3px); mask-image: radial-gradient(circle at 20% 50%, transparent 2px, black 3px), radial-gradient(circle at 45% 30%, transparent 1.5px, black 2.5px), radial-gradient(circle at 70% 70%, transparent 2.5px, black 3.5px), radial-gradient(circle at 85% 40%, transparent 1px, black 2px), radial-gradient(circle at 10% 80%, transparent 1.5px, black 3px); filter: blur(0.3px) contrast(1.2); }
  
  .scroll-spacer { height: 100vh; height: 100lvh; pointer-events: none; }

  .info-section { 
    position: sticky; top: 0; z-index: 20; 
    height: 100vh; height: 100lvh; 
    width: 100vw; 
    display: flex; align-items: center; justify-content: center; 
    padding: 100px 40px; 
    background-color: #050505; 
    border-radius: 60px 60px 0 0; 
    box-shadow: 0 -20px 60px rgba(0,0,0,0.9);
    overflow: hidden; 
    transform-origin: 50% 35%; 
    will-change: transform; 
  }
  .info-dim { position: absolute; inset: 0; z-index: 5; pointer-events: none; opacity: 0; background: radial-gradient(ellipse at 50% 30%, rgba(3,3,3,0.6), #030303 85%); }
  .p2-dwell { height: 60vh; height: 60lvh; pointer-events: none; }
  .content-block { max-width: 1000px; width: 100%; position: relative; z-index: 2; margin-top: 10vh; }
  
  .roles-grid { display: grid; grid-template-columns: 1fr; gap: 60px; text-align: center; transform: translateY(150px); opacity: 0; transform: translateZ(0); backface-visibility: hidden; }
  @media (min-width: 768px) { .roles-grid { grid-template-columns: repeat(3, 1fr); } }
  .role-item h3 { font-family: 'Playfair Display', serif; font-size: 24px; font-style: italic; font-weight: 400; margin: 0 0 10px; color: #fff; }
  .role-item p { font-size: 11px; color: #777; letter-spacing: 0.1em; margin: 0; }
  
  .action-area { text-align: center; margin-top: 80px; transform: translateY(150px); opacity: 0; transform: translateZ(0); backface-visibility: hidden; }
  .contact-btn { display: inline-flex; flex-direction: column; align-items: center; text-decoration: none; padding: 16px 40px; position: relative; overflow: hidden; transition: all 0.4s ease; cursor: default; }
  .contact-btn::before, .contact-btn::after { content: ''; position: absolute; left: 0; width: 100%; height: 1px; background: var(--gold); transition: background 0.4s, transform 0.4s; }
  .contact-btn::before { top: 0; }
  .contact-btn::after { bottom: 0; }
  .contact-btn .btn-text { color: var(--gold); font-family: 'Courier Prime', monospace; font-size: 14px; letter-spacing: 0.25em; position: relative; z-index: 2; transition: color 0.4s; }
  .contact-btn:hover { background: rgba(212, 175, 55, 0.05); }
  .contact-btn:hover::before, .contact-btn:hover::after { box-shadow: 0 0 15px rgba(212, 175, 55, 0.6); background: #fff; }
  .contact-btn:hover .btn-text { color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.5); }

  /* ====== 第三页：拉长到 500vh ====== */
  .page-three { 
    --paper-base: #ffffff; 
    --ink: #000000; 
    --ink-soft: #444444; 
    --oxblood: #7b1e1e; 
    
    position: relative; z-index: 30; 
    height: 500vh; height: 500lvh; /* 加长滑动距离 */
    width: 100vw; 
    background-color: var(--paper-base); 
    border-radius: 0; 
    box-shadow: 0 -20px 40px rgba(0,0,0,0.1); 
  }

  .p3-stage { position: sticky; top: 0; height: 100vh; height: 100lvh; overflow: hidden; color: var(--ink); background-color: #ffffff; }
  .p3-lantern { position: absolute; left: 0; top: 0; width: 90vmax; height: 90vmax; margin: -45vmax 0 0 -45vmax; background: radial-gradient(circle, rgba(0,0,0,0.02) 0%, transparent 60%); pointer-events: none; will-change: transform; transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
  
  .p3-inner { position: absolute; inset: 0; z-index: 3; display: flex; flex-direction: column; padding: clamp(24px, 4vw, 56px) clamp(24px, 5vw, 80px) clamp(24px, 4vh, 48px); }
  .p3-mast { display: flex; justify-content: space-between; font-size: 11px; letter-spacing: 0.35em; color: var(--ink-soft); padding-bottom: 16px; border-bottom: 4px double rgba(0,0,0,0.8); font-weight: 700; text-transform: uppercase; flex-shrink: 0; }
  .p3-cases { position: relative; flex: 1; display: flex; align-items: center; width: 100%; max-width: 1200px; margin: 0 auto; }

  .case { position: absolute; inset: 0; display: flex; opacity: 0; visibility: hidden; pointer-events: none; transform: translate3d(0, 4vh, 0); transition: opacity 0.6s ease, transform 0.9s cubic-bezier(0.5, 0, 0.2, 1), visibility 0s linear 0.9s; }
  .case.is-past { transform: translate3d(0, -4vh, 0); }
  .case.is-active { opacity: 1; visibility: visible; pointer-events: auto; transform: none; transition: opacity 0.8s ease 0.15s, transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s, visibility 0s linear 0s; }
  
  .case--intro { flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .intro-title { margin: 0; font-weight: 900; font-style: italic; font-size: clamp(42px, 9vw, 130px); line-height: 0.95; text-wrap: balance; color: var(--ink); }
  .intro-title .line { display: block; overflow: hidden; padding: 0.08em 0.12em 0.16em; margin: -0.08em -0.12em -0.16em; }
  .intro-title .line > span { display: inline-block; transform: translate3d(0, 115%, 0); transition: transform 0.6s ease; }
  .intro-title .line:nth-child(2) > span { background: linear-gradient(90deg, var(--ink) 30%, rgba(0,0,0,0.4) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; }
  .case.is-active .intro-title .line > span { transform: none; transition: transform 1.3s cubic-bezier(0.2, 0.8, 0.2, 1) calc(0.3s + var(--i, 0) * 0.14s); }
  .case.is-past .intro-title .line > span { transform: translate3d(0, -115%, 0); }

  /* 倾斜笔尖扫描 */
  .handwritten-area { display: flex; flex-direction: column; align-items: center; margin-top: 40px; }
  .handwritten-text {
    font-family: 'Playfair Display', serif; font-style: italic; font-size: clamp(18px, 2.2vw, 28px);
    color: var(--ink-soft); margin: 0;
    -webkit-mask-image: linear-gradient(110deg, transparent 0%, black 15%, black 85%, transparent 100%);
    -webkit-mask-size: 300% 100%; -webkit-mask-position: 100% 0;
    mask-image: linear-gradient(110deg, transparent 0%, black 15%, black 85%, transparent 100%);
    mask-size: 300% 100%; mask-position: 100% 0;
    transition: none;
  }
  .handwritten-hint {
    display: flex; align-items: center; gap: 12px; margin-top: 30px; color: var(--ink);
    font-family: 'Courier Prime', monospace; font-size: clamp(14px, 2vw, 18px); font-weight: 700; letter-spacing: 0.4em;
    -webkit-mask-image: linear-gradient(110deg, transparent 0%, black 15%, black 85%, transparent 100%);
    -webkit-mask-size: 300% 100%; -webkit-mask-position: 100% 0;
    mask-image: linear-gradient(110deg, transparent 0%, black 15%, black 85%, transparent 100%);
    mask-size: 300% 100%; mask-position: 100% 0;
    transition: none;
  }
  .scribble-arrow { width: 20px; height: 20px; opacity: 0; }

  .case.is-active .handwritten-text {
    -webkit-mask-position: -50% 0; mask-position: -50% 0;
    transition: -webkit-mask-position 2.8s cubic-bezier(0.45, 0.05, 0.55, 0.95) 0.6s, mask-position 2.8s cubic-bezier(0.45, 0.05, 0.55, 0.95) 0.6s; 
  }
  .case.is-active .handwritten-hint {
    -webkit-mask-position: -50% 0; mask-position: -50% 0;
    transition: -webkit-mask-position 1.8s cubic-bezier(0.4, 0.0, 0.2, 1) 3.8s, mask-position 1.8s cubic-bezier(0.4, 0.0, 0.2, 1) 3.8s; 
  }
  .case.is-active .scribble-arrow { animation: fadeInArrow 0.4s ease 5.6s forwards; }
  @keyframes fadeInArrow { to { opacity: 0.6; } }

  /* ====== 常规文件排版 ====== */
  .case--file { position: relative; align-items: center; width: 100%; }
  .case-num { position: absolute; left: -5%; top: 50%; font-style: italic; font-weight: 900; line-height: 0.8; letter-spacing: -0.06em; font-size: clamp(240px, 35vw, 600px); color: transparent; -webkit-text-stroke: 2px rgba(0,0,0,0.08); user-select: none; opacity: 0; transform: translateY(-50%) translateX(-50px) scale(1.05); transition: opacity 0.5s ease, transform 0.5s ease; z-index: 1; }
  .case.is-active .case-num { opacity: 1; transform: translateY(-50%) translateX(0) scale(1); transition: opacity 1.4s ease 0.1s, transform 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s; }

  .case-text { position: relative; z-index: 2; width: 100%; max-width: 580px; margin-left: 20%; display: flex; flex-direction: column; justify-content: center; }
  .case-header-group { margin-bottom: 40px; }
  .case-title { display: block; margin: 0; font-weight: 900; font-style: italic; font-size: clamp(40px, 5.5vw, 80px); line-height: 1.05; color: var(--ink); clip-path: inset(-12% 100% -12% 0); transition: clip-path 0.5s ease; }
  .case.is-active .case-title { clip-path: inset(-12% 0 -12% 0); transition: clip-path 1.3s cubic-bezier(0.65, 0, 0.15, 1) calc(0.3s + var(--i, 0) * 0.12s); }
  .case-sub { font-style: italic; font-size: clamp(18px, 2vw, 26px); color: rgba(0,0,0,0.5); margin: 16px 0 0 0; }
  
  .rule { display: block; width: 80px; height: 3px; margin: 0 0 32px 0; background: var(--oxblood); transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease; }
  .case.is-active .rule { transform: scaleX(1); transition: transform 1s cubic-bezier(0.65, 0, 0.15, 1) calc(0.5s + var(--i, 0) * 0.12s); }
  
  .case-body { font-size: clamp(16px, 1.4vw + 2px, 18px); line-height: 2.1; color: var(--ink-soft); margin: 0; max-width: 48em; text-align: justify; }
  .case-body.dropcap::first-letter { float: left; font-weight: 900; font-size: 4.5em; line-height: 0.75; padding: 0.1em 0.1em 0 0; color: #d4af37; font-style: italic; }
  
  .p3-sign { margin-top: 40px; }
  .p3-sign-off { font-style: italic; font-size: 16px; color: var(--ink-soft); margin: 0; }
  .p3-signature { font-family: 'Pinyon Script', cursive; font-size: clamp(54px, 6vw, 84px); color: var(--ink); margin: -6px 0 0; line-height: 1; display: inline-block; transform: rotate(-5deg); transform-origin: left center; }
  
