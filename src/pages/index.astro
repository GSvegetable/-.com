---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="The Blank Front Page">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Courier+Prime&display=swap" rel="stylesheet">

  <div class="debug-progress mono" id="progress-indicator">0%</div>

  <!-- 第一页 -->
  <section class="hero-section">
    <div class="perspective-wrap">
      <div class="hero-stage" id="hero-masthead" style="transform: translate3d(0, -10vh, 0) rotateX(0deg) scaleY(1);">
        
        <div class="bg-layer">
          <div class="bg-image active" style="background-image: url('/bg1.jpg')"></div>
          <div class="bg-image" style="background-image: url('/bg2.jpg')"></div>
          <div class="bg-image" style="background-image: url('/bg3.jpg')"></div>
          <div class="bg-image" style="background-image: url('/bg4.jpg')"></div>
          <div class="bg-image" style="background-image: url('/bg5.jpg')"></div>
          <div class="bg-image" style="background-image: url('/bg6.jpg')"></div>
        </div>

        <div class="newspaper-masthead">
          <div class="masthead-top mono">
            <span>VOL. I</span>
            <span>LONDON GAZETTE</span>
            <span>EST. 1888</span>
          </div>

          <div class="letter-body">
            <div class="header-group">
              <p class="salutation">To the Esteemed Visionaries,</p>
            </div>
            
            <div class="content-group">
              <p class="greeting">Dear Partner,</p>
              <p class="body-text">
                The year is <span class="highlight">1888</span>. The city drowns in mist, and mysteries unfold in the gaslight. We are crafting a grand illusion <span class="highlight">(Unreal Engine 5)</span>, a world of shadows and truth. 
              </p>
              <!-- 需求1：Singapore 改为 Toronto -->
              <p class="body-text">
                We seek the Architects, the Illustrators, and the Chroniclers. We welcome you in <span class="highlight">London</span>, <span class="highlight">Shanghai</span>, and <span class="highlight">Toronto</span>.
              </p>
            </div>
            
            <div class="signature-group">
              <p class="sign-off">Yours in the mist,</p>
              <p class="signature ink-break">Gong Shui.</p>
            </div>
          </div>
        </div>

        <div class="fade-mask" id="fade-mask"></div>
      </div>
    </div>
  </section>

  <div class="scroll-spacer"></div>

  <!-- 第二页 -->
  <section class="info-section" id="info-section">
    <!-- 需求4：顶部边缘模糊遮罩，JS控制它在80%时消失 -->
    <div class="top-fade-mask" id="top-fade-mask"></div>

    <div class="content-block">
      <!-- 需求2：标题改为加入社区 -->
      <h2 class="section-title mono">JOIN THE COMMUNITY</h2>
      
      <div class="roles-grid">
        <div class="role-item"><h3>UE5 / C++</h3><p>SYSTEM ARCHITECTURE</p></div>
        <div class="role-item"><h3>3D / LIGHTING</h3><p>ENVIRONMENT ART</p></div>
        <div class="role-item"><h3>NARRATIVE</h3><p>STORY & MECHANICS</p></div>
      </div>
      
      <div class="action-area">
        <!-- 需求3：重做按钮设计 -->
        <a href="mailto:hi@gongshui.com" class="contact-btn">
          <span class="btn-text">INITIATE CONTACT</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  :global(html) { overscroll-behavior-y: none; }
  :global(body) {
    margin: 0; padding: 0;
    background-color: #030303;
    color: #e8e8e8;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    overscroll-behavior-y: none;
  }
  :global(::-webkit-scrollbar) { display: none; width: 0 !important; }
  .mono { font-family: 'Courier Prime', monospace; }

  .debug-progress {
    position: fixed; top: 20px; right: 20px;
    color: #d4af37; font-size: 14px; z-index: 9999;
    background: rgba(0,0,0,0.5); padding: 4px 8px;
    border-radius: 4px; border: 1px solid rgba(212, 175, 55, 0.3);
    pointer-events: none;
  }

  /* ======= 第一页 ======= */
  .hero-section { 
    position: fixed; inset: 0;
    height: 100vh; height: 100lvh;
    display: flex; align-items: center; justify-content: center; 
    z-index: 10; overflow: hidden; pointer-events: none;
  }

  .perspective-wrap {
    perspective: 2500px; 
    perspective-origin: 50% 0%; 
    width: 100%; height: 100%;
    display: flex; justify-content: center; align-items: center;
  }

  .hero-stage {
    position: relative;
    width: 100%; max-width: 900px; height: 100vh; height: 100lvh;
    display: flex; flex-direction: column; justify-content: center;
    padding: 0 40px;
    transform-origin: center bottom; 
    will-change: transform, opacity;
    pointer-events: auto;
    opacity: 0; transition: opacity 0.3s ease-out;
  }
  .hero-stage.loaded { opacity: 1; }

  .bg-layer { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .bg-image {
    position: absolute; inset: 0; width: 100%; height: 100%;
    background-size: cover; background-position: center;
    filter: grayscale(100%) contrast(130%) brightness(0.2);
    opacity: 0; transition: opacity 3s ease-in-out; 
  }
  .bg-image.active { opacity: 1; }

  .fade-mask {
    position: absolute; inset: -30% 0 0 0;
    background: linear-gradient(to bottom, #030303 0%, transparent 60%);
    opacity: 0; pointer-events: none; z-index: 5;
  }

  .newspaper-masthead { position: relative; width: 100%; display: flex; flex-direction: column; }
  .masthead-top { display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.15); padding: 0 0 12px 0; font-size: 10px; letter-spacing: 0.3em; color: #888; margin-bottom: 30px; }
  .letter-body { padding: 20px 0; display: flex; flex-direction: column; position: relative; border-left: 1px solid rgba(255,255,255,0.1); padding-left: 30px; margin-left: 10px; margin-top: 10px; }
  .header-group { margin-bottom: 24px; }
  .salutation { font-family: 'Pinyon Script', cursive; font-size: clamp(40px, 5vw, 60px); color: #f4eee0; margin: 0; text-shadow: 1px 1px 2px rgba(0,0,0,0.8); }
  .content-group { max-width: 80%; }
  .greeting { font-family: 'Pinyon Script', cursive; font-size: 32px; color: #d1c5b4; margin: 0 0 16px 0; }
  .body-text { font-family: 'Playfair Display', serif; font-size: 16px; line-height: 1.8; color: #a39b8d; margin: 0 0 16px 0; text-align: justify; }
  .highlight { color: #d4af37; font-weight: 700; font-style: italic; }
  .signature-group { margin-top: 20px; }
  .sign-off { font-family: 'Playfair Display', serif; font-style: italic; font-size: 14px; color: #777; margin: 0; }
  
  .signature { font-family: 'Pinyon Script', cursive; font-size: clamp(50px, 6vw, 70px); color: #f4eee0; margin: 0; transform: rotate(-5deg); display: inline-block; text-shadow: 2px 2px 4px rgba(0,0,0,0.8); }

  .ink-break {
    -webkit-mask-image: radial-gradient(circle at 20% 50%, transparent 2px, black 3px), radial-gradient(circle at 45% 30%, transparent 1.5px, black 2.5px), radial-gradient(circle at 70% 70%, transparent 2.5px, black 3.5px), radial-gradient(circle at 85% 40%, transparent 1px, black 2px), radial-gradient(circle at 10% 80%, transparent 1.5px, black 3px);
    mask-image: radial-gradient(circle at 20% 50%, transparent 2px, black 3px), radial-gradient(circle at 45% 30%, transparent 1.5px, black 2.5px), radial-gradient(circle at 70% 70%, transparent 2.5px, black 3.5px), radial-gradient(circle at 85% 40%, transparent 1px, black 2px), radial-gradient(circle at 10% 80%, transparent 1.5px, black 3px);
    filter: blur(0.3px) contrast(1.2); 
  }

  .scroll-spacer { height: 100vh; height: 100lvh; pointer-events: none; }

  /* ======= 第二页 ======= */
  .info-section { 
    position: relative; z-index: 20; min-height: 100vh; min-height: 100lvh;
    display: flex; align-items: center; justify-content: center;
    padding: 100px 40px;
    background-color: rgba(5, 5, 5, 0.85);
    /* 增加圆角，让“分界线”清晰时更有质感 */
    border-radius: 60px 60px 0 0;
  }

  /* 顶部模糊遮罩层 */
  .top-fade-mask {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 120px;
    background: linear-gradient(to bottom, #050505 0%, transparent 100%);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border-radius: 60px 60px 0 0;
    pointer-events: none;
    z-index: 10;
    opacity: 1; /* JS 会在 80% 时将其降为 0 */
    will-change: opacity;
  }
  
  .content-block { max-width: 1000px; width: 100%; position: relative; z-index: 2; margin-top: 10vh; }
  .section-title { font-family: 'Playfair Display', serif; font-size: 16px; letter-spacing: 0.3em; font-weight: 400; color: #d4af37; text-align: center; margin-bottom: 60px; }
  
  .roles-grid { display: grid; grid-template-columns: 1fr; gap: 60px; text-align: center; }
  @media (min-width: 768px) { .roles-grid { grid-template-columns: repeat(3, 1fr); } }
  .role-item h3 { font-family: 'Playfair Display', serif; font-size: 24px; font-style: italic; font-weight: 400; margin: 0 0 10px; color: #fff; }
  .role-item p { font-size: 11px; color: #777; letter-spacing: 0.1em; margin: 0; }
  
  .action-area { text-align: center; margin-top: 80px; }

  /* 需求3：全新高级按钮设计 */
  .contact-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    padding: 16px 40px;
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }
  
  /* 按钮的上下金线 */
  .contact-btn::before, .contact-btn::after {
    content: '';
    position: absolute;
    left: 0; width: 100%; height: 1px;
    background: var(--gold);
    transition: background 0.4s, transform 0.4s;
  }
  .contact-btn::before { top: 0; }
  .contact-btn::after { bottom: 0; }

  /* 中间微弱的暗金光晕背景 */
  .contact-btn .btn-text {
    color: var(--gold);
    font-family: 'Courier Prime', monospace;
    font-size: 14px;
    letter-spacing: 0.25em;
    position: relative;
    z-index: 2;
    transition: color 0.4s;
  }

  .contact-btn::before {
    box-shadow: 0 0 10px rgba(212, 175, 55, 0); /* 用于悬停时发光 */
  }

  /* 悬停效果：上下金线发光，背景透出微光，文字变白 */
  .contact-btn:hover { background: rgba(212, 175, 55, 0.05); }
  .contact-btn:hover::before, .contact-btn:hover::after {
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.6);
    background: #fff;
  }
  .contact-btn:hover .btn-text { color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.5); }


  @media (max-width: 600px) {
    .hero-stage { padding: 0 20px; }
    .letter-body { padding: 20px 0 20px 20px; margin-left: 0; }
    .content-group { max-width: 100%; }
    .salutation { font-size: 36px; }
    .info-section { padding: 80px 20px; border-radius: 40px 40px 0 0; }
    .top-fade-mask { border-radius: 40px 40px 0 0; height: 80px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const bgImages = document.querySelectorAll('.bg-image');
    const heroStage = document.getElementById('hero-masthead');
    const fadeMask = document.getElementById('fade-mask');
    const progressIndicator = document.getElementById('progress-indicator');
    const topFadeMask = document.getElementById('top-fade-mask');
    
    heroStage.classList.add('loaded');

    let currentIndex = 0;
    setInterval(() => {
      bgImages[currentIndex].classList.remove('active');
      bgImages[currentIndex].style.zIndex = '0';
      currentIndex = (currentIndex + 1) % bgImages.length;
      const newBg = bgImages[currentIndex];
      newBg.style.zIndex = '1';
      newBg.classList.add('active');
    }, 5000);

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          const windowHeight = window.innerHeight;
          
          const totalScrollable = document.documentElement.scrollHeight - windowHeight;
          const globalProgress = Math.min(1, Math.max(0, scrollY / totalScrollable));
          
          progressIndicator.textContent = Math.round(globalProgress * 100) + '%';

          const heroProgress = Math.min(1, Math.max(0, scrollY / windowHeight));

          const rotateX = heroProgress * 70; 
          const rad = rotateX * Math.PI / 180;
          const stretchY = (1 / Math.cos(rad)) * 1.05; 
          
          const translateY = -10 + (Math.pow(heroProgress, 2) * 8); 

          heroStage.style.transform = `
            translate3d(0, ${translateY}vh, 0) 
            rotateX(${rotateX}deg) 
            scaleY(${stretchY})
          `;
          
          heroStage.style.opacity = Math.max(0, 1 - (heroProgress * 0.5));
          fadeMask.style.opacity = Math.max(0, (heroProgress - 0.3) * 1.5);

          // 需求4：当全局进度达到 80% 时，分界线的模糊完全消失
          if (globalProgress >= 0.8) {
            topFadeMask.style.opacity = 0;
          } else {
            topFadeMask.style.opacity = 1;
          }

          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    window.dispatchEvent(new Event('scroll'));
  });
</script>
