---
// 高级杂志排版风 - Editorial Design
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>宫水.com</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;400;800&family=Noto+Serif+SC:wght@200;500&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- 逼真的纸张噪点纹理 -->
    <div class="grain"></div>

    <main class="layout">
      <!-- 左上角细节 -->
      <header class="header">
        <span class="meta">© 2026 MIYAMIZU.COM</span>
      </header>

      <!-- 核心排版区 -->
      <section class="content">
        <h1 class="main-title">
          <span class="line-1">懒得</span>
          <span class="line-2">做了</span>
        </h1>
        
        <div class="subtitle-wrapper">
          <div class="divider"></div>
          <p class="sub-text">
            但域名都买了，<br>凑合看吧
          </p>
        </div>
      </section>

      <!-- 右下角细节 -->
      <footer class="footer">
        <div class="status">
          <span class="dot"></span> UNDER CONSTRUCTION
        </div>
      </footer>
    </main>
  </body>
</html>

<style>
  /* 颜色变量：极简黑白灰 */
  :root {
    --bg: #f4f4f2; /* 宣纸灰，比纯白高级 */
    --text: #111111;
    --gray: #888888;
    --font-sans: 'Inter', -apple-system, sans-serif;
    --font-serif: 'Noto Serif SC', serif;
  }

  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* 真实纸张噪点覆盖层 (Film Grain) */
  .grain {
    position: fixed;
    inset: 0;
    z-index: 99;
    pointer-events: none;
    opacity: 0.05; /* 非常克制，只增加质感 */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  .layout {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 4vw;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* 顶部小字 */
  .header .meta {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gray);
  }

  /* 核心排版区 */
  .content {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex: 1;
    padding-bottom: 10vh;
  }

  /* 主标题：超大极简黑体 */
  .main-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(6rem, 18vw, 22rem);
    font-weight: 800;
    line-height: 0.8; /* 极小的行高，创造紧凑排版 */
    letter-spacing: -0.05em;
    display: flex;
    flex-direction: column;
  }
  
  .line-1 { margin-left: 0; }
  .line-2 { margin-left: 25vw; } /* 错位排版 */

  /* 副标题区域：极细衬线体 */
  .subtitle-wrapper {
    margin-bottom: 2vw;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .divider {
    width: 40px;
    height: 1px;
    background-color: var(--text);
    margin-bottom: 1.5rem;
  }

  .sub-text {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
    font-weight: 200;
    line-height: 1.8;
    letter-spacing: 0.1em;
    margin: 0;
    color: var(--text);
  }

  /* 底部状态 */
  .footer {
    display: flex;
    justify-content: flex-end;
  }

  .status {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--gray);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* 极其微小的闪烁点，代表“未完工” */
  .dot {
    width: 6px;
    height: 6px;
    background-color: #ff4444;
    border-radius: 50%;
    animation: blink 2s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }

  /* 响应式适配 */
  @media (max-width: 768px) {
    .layout { padding: 8vw; }
    .content {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 3rem;
      padding-bottom: 5vh;
    }
    .line-2 { margin-left: 15vw; }
    .footer { justify-content: flex-start; margin-top: 2rem; }
  }
</style>
