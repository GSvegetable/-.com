---
// SVG 滤镜水波 + 极简狂草书法
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>宫水.com</title>
    <!-- 引入行书和极简无衬线体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zhi+Mang+Xing&family=Inter:wght@300&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- 隐藏的 SVG 滤镜，用来做文字水波扭曲 -->
    <svg class="hidden-svg">
      <defs>
        <filter id="water-filter">
          <feTurbulence id="turbulence" type="fractalNoise" baseFrequency="0.015 0.015" numOctaves="3" result="noise" />
          <feDisplacementMap id="displacement" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>

    <!-- 点击产生的水波圈容器 -->
    <div id="ripple-container"></div>

    <main class="layout">
      <!-- 核心文字区域，应用了水波滤镜 -->
      <div class="content" id="distort-target">
        <h1 class="main-text">懒得做了</h1>
        <p class="sub-text">但域名都买了，凑合看吧</p>
      </div>
    </main>

    <script is:inline>
      const target = document.getElementById('distort-target');
      const turbulence = document.getElementById('turbulence');
      const displacement = document.getElementById('displacement');
      let animId;
      let scale = 0;

      // 触发水波形变动画
      function triggerWaterDistort() {
        cancelAnimationFrame(animId);
        scale = 60; // 初始形变强度

        function animate() {
          scale *= 0.95; // 缓慢衰减，营造层层晕开的感觉
          
          if (scale < 0.5) {
            target.style.filter = 'none';
            return;
          }

          displacement.setAttribute('scale', scale);
          // 改变频率，让波纹在回弹时产生复杂的变化
          const freq = 0.015 + (60 - scale) * 0.0002;
          turbulence.setAttribute('baseFrequency', `${freq} ${freq}`);

          animId = requestAnimationFrame(animate);
        }
        animate();
      }

      // 点击事件
      document.body.addEventListener('pointerdown', (e) => {
        // 1. 触发文字扭曲
        triggerWaterDistort();

        // 2. 在点击处生成多层扩散的水波圈
        for (let i = 0; i < 3; i++) {
          setTimeout(() => {
            const ripple = document.createElement('div');
            ripple.className = 'water-ring';
            ripple.style.left = `${e.clientX}px`;
            ripple.style.top = `${e.clientY}px`;
            document.getElementById('ripple-container').appendChild(ripple);

            setTimeout(() => { ripple.remove(); }, 2500);
          }, i * 250); // 三层波纹，每层延迟0.25秒，形成“层层晕开”的视觉
        }
      });
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #050505;
    --text: #f5f5f5;
    --font-cn: 'Zhi Mang Xing', cursive;
    --font-en: 'Inter', sans-serif;
  }

  html, body {
    margin: 0; padding: 0;
    width: 100%; height: 100%;
    background-color: var(--bg);
    color: var(--text);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: crosshair;
  }

  .hidden-svg { position: absolute; width: 0; height: 0; }

  .layout {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none; /* 让点击事件穿透到 body */
  }

  .content {
    text-align: center;
    /* 必须有 transition，否则 JS 改变滤镜时文字会闪烁 */
    transition: filter 0.1s linear; 
    will-change: filter;
  }

  /* 夸张的英伦风草书（中式） */
  .main-text {
    font-family: var(--font-cn);
    font-size: clamp(6rem, 18vw, 15rem);
    font-weight: 400;
    line-height: 1;
    margin: 0;
    letter-spacing: 0.05em;
    /* 极具张力的阴影雕刻感 */
    text-shadow: 2px 4px 15px rgba(255, 255, 255, 0.1);
  }

  .sub-text {
    font-family: var(--font-cn);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    color: rgba(255, 255, 255, 0.5);
    margin-top: 2rem;
    letter-spacing: 0.1em;
  }

  /* 层层晕开的水波圈 */
  .water-ring {
    position: absolute;
    width: 0px; height: 0px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
    /* 慢速扩散 + 回弹感 */
    animation: ripple-expand 2.5s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
  }

  @keyframes ripple-expand {
    0% {
      width: 0px; height: 0px;
      opacity: 1;
      border-width: 4px;
      border-color: rgba(255, 255, 255, 0.8);
    }
    50% {
      border-width: 2px;
      border-color: rgba(255, 255, 255, 0.3);
    }
    100% {
      /* 扩散到非常大，模拟撞到屏幕边缘 */
      width: 150vw; height: 150vw; 
      opacity: 0;
      border-width: 0px;
    }
  }
</style>
