---
// 纯黑底 + 极度夸张狂草手写错落排版
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>凑合看</title>
    <!-- 引入 Google Fonts 中最夸张的中文狂草手写体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zhi+Mang+Xing&display=swap" rel="stylesheet">
  </head>
  <body>
    <main class="wrapper">
      <!-- 第一句：巨大、左上倾斜 -->
      <h1 class="text-main">凑合看</h1>
      
      <!-- 第二句：略小、右下倾斜、穿插 -->
      <h2 class="text-sub">今天审美不在线</h2>
    </main>

    <script is:inline>
      // 极其微弱的鼠标跟随倾斜，增加一点物理呼吸感，不花哨
      const main = document.querySelector('.text-main');
      const sub = document.querySelector('.text-sub');

      document.addEventListener('mousemove', (e) => {
        const x = (e.clientX / window.innerWidth - 0.5) * 15;
        const y = (e.clientY / window.innerHeight - 0.5) * 15;

        // 对角线反向移动，产生错位错觉
        main.style.transform = `rotate(-8deg) translate(${x}px, ${y}px)`;
        sub.style.transform = `rotate(5deg) translate(${-x}px, ${-y}px)`;
      });
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    height: 100dvh; /* 锁定高度，禁止滑动 */
    overflow: hidden; /* 彻底禁用滚动 */
    background-color: #000000; /* 纯黑背景 */
    color: #ffffff;
    cursor: crosshair; /* 保持一点点锐利感 */
  }

  .wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* 字体基础设置：狂草手写、夸张的粗细对比 */
  .text-main, .text-sub {
    font-family: 'Zhi Mang Xing', cursive;
    font-weight: 400;
    position: absolute;
    white-space: nowrap;
    /* 初始过渡，让跟随效果更平滑 */
    transition: transform 0.1s linear; 
    will-change: transform;
    /* 极简的高级感：纯白字，不加任何发光、渐变 */
    color: #ffffff;
    -webkit-font-smoothing: antialiased;
  }

  /* 主句：极度放大，占据视觉中心偏左 */
  .text-main {
    font-size: clamp(10rem, 35vw, 40rem);
    top: 5%;
    left: -5%;
    transform: rotate(-8deg);
    z-index: 2;
  }

  /* 副句：穿插在主句右下角，形成压迫感 */
  .text-sub {
    font-size: clamp(4rem, 12vw, 15rem);
    bottom: 10%;
    right: -2%;
    transform: rotate(5deg);
    z-index: 1;
    /* 稍微给一点点暗白色，拉开层次 */
    color: #e0e0e0; 
  }

  /* 针对小屏幕适配 */
  @media (max-width: 768px) {
    .text-main {
      font-size: 35vw;
      top: 15%;
      left: -10%;
    }
    .text-sub {
      font-size: 14vw;
      bottom: 20%;
      right: 0;
    }
  }
</style>
