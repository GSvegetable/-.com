---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">宫水 · GONG SHUI</p>
      <h1 class="hero-title serif">在水边，<br />慢慢写。</h1>
      <p class="hero-sub">一些关于水、日常和缓慢的记录。不追热点，也不急着更新。</p>
      <div class="hero-actions">
        <a href="/notes" class="btn">读文章</a>
        <a href="/about" class="btn btn-ghost">这是哪里</a>
      </div>
    </div>
    <div class="hero-ring" aria-hidden="true"></div>
  </section>

  <section class="latest container">
    <div class="section-head">
      <h2 class="serif">最近的流水</h2>
      <a href="/notes" class="more">全部文章 →</a>
    </div>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/notes/${post.id}/`} class="post-item">
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <span class="post-title serif">{post.data.title}</span>
            <span class="post-desc">{post.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="fragment container">
    <p class="serif">「水没有形状，但它记得每一块石头。」</p>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; padding: 96px 0 72px; }
  .hero-ring { position: absolute; right: -140px; bottom: -180px; width: 420px; height: 420px; border-radius: 50%; border: 1px solid rgba(79, 125, 138, .18); box-shadow: 0 0 0 40px rgba(79, 125, 138, .05), 0 0 0 90px rgba(79, 125, 138, .03); pointer-events: none; }
  .hero-title { margin: 0; font-size: clamp(40px, 8vw, 68px); font-weight: 500; line-height: 1.18; letter-spacing: .04em; color: var(--ink); }
  .hero-sub { max-width: 420px; margin: 24px 0 0; font-size: 15px; line-height: 1.9; color: var(--ink-soft); }
  .hero-actions { display: flex; gap: 12px; margin-top: 36px; }
  .btn { display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 999px; background: var(--ink); color: var(--paper); font-size: 13px; letter-spacing: .04em; text-decoration: none; transition: background .15s; }
  .btn:hover { background: var(--water-deep); }
  .btn-ghost { background: transparent; color: var(--ink-soft); border: 1px solid var(--line); }
  .btn-ghost:hover { background: transparent; color: var(--ink); border-color: var(--ink-soft); }
  .latest { padding: 24px 24px 0; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 8px; }
  .section-head h2 { margin: 0; font-size: 18px; font-weight: 500; letter-spacing: .04em; }
  .more { font-size: 12.5px; color: var(--muted); text-decoration: none; transition: color .15s; }
  .more:hover { color: var(--water-deep); }
  .fragment { padding: 80px 24px 104px; text-align: center; }
  .fragment p { margin: 0; font-size: 17px; line-height: 1.9; color: var(--muted); }
  @media (max-width: 560px) {
    .hero { padding: 64px 0 48px; }
    .hero-ring { display: none; }
    .fragment { padding: 56px 24px 72px; }
  }
</style>
