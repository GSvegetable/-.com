---
// 纯黑底 + 极简居中 + 英国华丽手写体
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Make do</title>
    <!-- 引入英国华丽手写体 (Pinyon Script 和 Great Vibes) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Pinyon+Script&display=swap" rel="stylesheet">
  </head>
  <body>
    <main class="wrapper">
      <!-- 翻译: 凑合看 / 今天审美不在线 -->
      <h1 class="text-main">Make do</h1>
      <h2 class="text-sub">aesthetic offline today</h2>
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    height: 100dvh; /* 锁死高度 */
    overflow: hidden; /* 彻底禁用上下滑动 */
    background-color: #000000; /* 纯黑背景 */
    color: #ffffff;
  }

  .wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    /* 绝对水平居中，无任何 transform 或旋转 */
  }

  /* 主句：极度夸张华丽的英文手写体 */
  .text-main {
    font-family: 'Pinyon Script', cursive;
    font-size: clamp(6rem, 18vw, 20rem);
    line-height: 1;
    font-weight: 400;
    /* 极简的纯白，无渐变 */
    color: #ffffff;
    /* 稍微往下压一点点，给副标题留出呼吸空间 */
    margin-bottom: -2vw; 
  }

  /* 副句：同样用手写体，但字号小一些，拉开视觉层次 */
  .text-sub {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(2.5rem, 6vw, 7rem);
    line-height: 1.5;
    font-weight: 400;
    color: #a0a0a0; /* 稍微灰一点点，不抢主句风头 */
  }
</style>
