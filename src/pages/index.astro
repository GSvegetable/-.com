---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="寻人启事" description="寻找那些能看穿迷雾的人">
  <div class="vintage-paper-overlay"></div>
  
  <!-- 顶部大标题区 -->
  <section class="container" style="padding-top: 100px; text-align: center; position: relative; z-index: 2;">
    <div class="header-line">
      <span class="mono text-muted">EST. 1888</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--gold)"><path d="M12 2L14 9L21 11L14 13L12 20L10 13L3 11L10 9L12 2Z"/></svg>
      <span class="mono text-muted">LONDON</span>
    </div>

    <p class="mono text-blood" style="letter-spacing: 0.4em; font-size: 12px; margin-bottom: 24px;">CONFIDENTIAL / WANTED</p>
    
    <h1 class="main-title">
      致那些能看穿<br><span class="text-gold">迷雾</span>的人
    </h1>
    
    <p class="mono text-muted" style="margin-top: 30px; font-size: 13px; letter-spacing: 0.1em;">
      《雾都疑云》独立游戏开发组 · 悬赏招募
    </p>
  </section>

  <!-- 中央核心卷宗（带撕裂边缘效果） -->
  <section class="container torn-dossier" style="margin-top: 60px; position: relative; z-index: 2;">
    <div style="padding: 40px;">
      <p style="margin-top: 0; color: var(--paper); font-size: 16px; font-style: italic; border-left: 2px solid var(--blood); padding-left: 16px;">
        这不是一份寻常的雇佣合同。
      </p>
      <p style="color: #c2b8a6; font-size: 15px; line-height: 2; text-indent: 2em;">
        我目前正在用虚幻引擎5（UE5）重构一个1888年的伦敦。那里没有魔法，只有蔓延的浓雾、闪烁的煤气灯、未被揭开的凶案，以及一份份等着被写上真相的报纸。
      </p>
      <p style="color: #c2b8a6; font-size: 15px; line-height: 2; text-indent: 2em;">
        玩家将在这里扮演“情报掮客”，游走于街头巷尾，拼凑线索，将新闻卖给报社换取生存的筹码。我一个人在雾里摸索得太久了，现在，我想找几个愿意一起进入这座城市的同伴。
      </p>
      
      <div style="margin-top: 30px; font-family: var(--mono); font-size: 12px; color: var(--text-muted); display: flex; gap: 20px; border-top: 1px dashed var(--line); padding-top: 20px;">
        <span>STATUS: PROTOTYPE</span>
        <span>ENGINE: UE5</span>
      </div>
    </div>
  </section>

  <!-- 招募职位列表 -->
  <section class="container" style="margin-top: 60px; position: relative; z-index: 2;">
    <h2 class="mono text-gold" style="font-size: 14px; letter-spacing: 0.1em; margin-bottom: 30px; border-bottom: 1px solid var(--line); padding-bottom: 10px;">
      [ DOSSIERS / 招募卷宗 ]
    </h2>
    
    <div class="job-grid">
      <!-- 岗位 1 -->
      <div class="job-card">
        <div class="job-icon">⚙️</div>
        <div>
          <h3>机械工匠</h3>
          <p class="mono text-muted" style="font-size: 11px; margin: 4px 0 8px;">UE5 客户端 / 系统开发</p>
          <p class="job-desc">懂蓝图或 C++。搭建情报收集、报社结算等底层逻辑，让这座雾都运转起来。</p>
        </div>
      </div>
      <!-- 岗位 2 -->
      <div class="job-card">
        <div class="job-icon">🎨</div>
        <div>
          <h3>光影画师</h3>
          <p class="mono text-muted" style="font-size: 11px; margin: 4px 0 8px;">3D 美术 / 场景地编</p>
          <p class="job-desc">构建湿冷阴郁的伦敦街头，擅长老旧建筑材质与维多利亚时期的阴间打光。</p>
        </div>
      </div>
      <!-- 岗位 3 -->
      <div class="job-card">
        <div class="job-icon">✒️</div>
        <div>
          <h3>迷雾说书人</h3>
          <p class="mono text-muted" style="font-size: 11px; margin: 4px 0 8px;">剧情 / 系统策划</p>
          <p class="job-desc">写出让人脊背发凉的连环案件，设计“拼凑线索写出绝妙新闻”的机制。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 底部印章与接头 -->
  <section class="container" style="text-align: center; padding: 80px 0 120px; position: relative; z-index: 2;">
    <!-- 物理质感的火漆印章 -->
    <div class="wax-seal">
      <div class="wax-inner">密</div>
    </div>
    
    <h2 style="font-size: 22px; margin-bottom: 12px; color: var(--paper); font-weight: normal; letter-spacing: 0.05em;">如果你听懂了煤气灯下的暗号</h2>
    <p class="text-muted" style="margin-bottom: 40px; font-size: 14px;">请留下你的密信。这里没有大厂的傲慢，只有一群想做好东西的疯子。</p>
    
    <a href="mailto:hi@gongshui.com" class="action-btn mono">
      SEND TRANSMISSION
    </a>
  </section>
</BaseLayout>

<style>
  /* 覆盖 layout 的黑色背景，加入多层渐变和噪点 */
  :global(body) {
    background-color: #0d0c0a;
    background-image: 
      radial-gradient(circle at 50% 0%, rgba(60, 45, 35, 0.4) 0%, transparent 60%),
      radial-gradient(circle at 10% 90%, rgba(80, 20, 20, 0.15) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.08'/%3E%3C/svg%3E");
    background-attachment: fixed;
  }

  .vintage-paper-overlay {
    position: fixed; inset: 0; pointer-events: none; z-index: 1;
    box-shadow: inset 0 0 150px rgba(0,0,0,0.9);
  }

  .header-line {
    display: flex; align-items: center; justify-content: center; gap: 16px; margin-bottom: 40px;
    opacity: 0.6;
  }

  .main-title {
    font-size: clamp(36px, 8vw, 64px);
    font-weight: 400;
    margin: 0;
    line-height: 1.2;
    letter-spacing: 0.05em;
    color: #f0e9db;
    text-shadow: 0 4px 20px rgba(0,0,0,0.8);
  }

  /* 撕纸效果的卷宗 */
  .torn-dossier {
    background: #141210;
    /* 使用 clip-path 模拟手撕的不规则边缘 */
    clip-path: polygon(
      0% 2%, 5% 0%, 15% 1%, 30% 0%, 45% 2%, 60% 0%, 75% 1%, 90% 0%, 100% 3%,
      99% 15%, 100% 30%, 98% 45%, 100% 60%, 99% 75%, 100% 90%, 98% 100%,
      90% 99%, 75% 100%, 60% 98%, 45% 100%, 30% 99%, 15% 100%, 5% 98%, 0% 100%,
      1% 85%, 0% 70%, 2% 55%, 0% 40%, 1% 25%
    );
    border: 1px solid #2a221c;
    box-shadow: inset 0 0 50px rgba(0,0,0,0.8), 0 20px 40px rgba(0,0,0,0.6);
  }

  .job-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .job-grid { grid-template-columns: 1fr 1fr 1fr; }
  }

  .job-card {
    display: flex; gap: 16px;
    padding: 24px;
    background: rgba(20, 18, 16, 0.6);
    border: 1px solid #2a221c;
    border-top: 2px solid var(--blood);
    transition: transform 0.3s, background 0.3s;
  }

  .job-card:hover {
    transform: translateY(-4px);
    background: rgba(30, 25, 20, 0.8);
  }

  .job-icon { font-size: 24px; opacity: 0.8; }
  .job-card h3 { margin: 0; font-size: 18px; color: var(--gold); font-weight: 500; letter-spacing: 0.05em; }
  .job-desc { margin: 0; font-size: 13px; color: #a39b8d; line-height: 1.6; }

  /* 逼真的火漆印章 */
  .wax-seal {
    width: 100px; height: 100px;
    margin: 0 auto 40px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #9e2020 0%, #5c0b0b 50%, #2b0303 100%);
    box-shadow: 
      0 10px 20px rgba(0,0,0,0.8),
      inset 0 4px 8px rgba(255,255,255,0.15),
      inset 0 -8px 15px rgba(0,0,0,0.8);
    display: flex; align-items: center; justify-content: center;
    position: relative;
    transform: rotate(-8deg);
  }

  .wax-inner {
    width: 76px; height: 76px;
    border-radius: 50%;
    border: 2px dashed rgba(255,200,200,0.15);
    display: flex; align-items: center; justify-content: center;
    color: #e8a2a2;
    font-family: var(--serif);
    font-size: 24px;
    font-weight: bold;
    letter-spacing: 0.1em;
    text-shadow: 1px 2px 2px rgba(0,0,0,0.8);
  }

  .action-btn {
    display: inline-block;
    padding: 16px 48px;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: all 0.4s;
  }

  .action-btn:hover {
    background: var(--gold);
    color: #000;
    box-shadow: 0 0 20px rgba(184, 155, 114, 0.4);
  }
</style>
