---
// 纯 CSS 高光液态玻璃文字
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>宫水.com</title>
  </head>
  <body>
    <!-- 背景流光：加强亮度 -->
    <div class="bg-glow glow-1"></div>
    <div class="bg-glow glow-2"></div>
    <div class="bg-glow glow-3"></div>

    <div class="container">
      <h1 class="glass-title" data-text="懒得做了">懒得做了</h1>
      <p class="glass-sub">但域名都买了，凑合看吧</p>
    </div>
  </body>
</html>

<style>
  html, body {
    margin: 0;
    padding: 0;
    height: 100vh;
    overflow: hidden;
    background-color: #030305;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* 增强版背景光晕 */
  .bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    z-index: 0;
    opacity: 0.8;
    animation: move-glow 10s infinite alternate ease-in-out;
  }
  .glow-1 {
    width: 50vw; height: 50vw;
    background: rgba(0, 255, 255, 0.4); /* 青色 */
    top: 0%; left: 10%;
  }
  .glow-2 {
    width: 60vw; height: 60vw;
    background: rgba(255, 0, 128, 0.3); /* 粉红 */
    bottom: -10%; right: 0%;
    animation-delay: -3s;
  }
  .glow-3 {
    width: 40vw; height: 40vw;
    background: rgba(130, 80, 255, 0.4); /* 紫色 */
    top: 30%; left: 40%;
    animation-delay: -6s;
  }

  @keyframes move-glow {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-5vw, 10vh) scale(1.1); }
  }

  .container {
    z-index: 1;
    text-align: center;
    position: relative;
  }

  /* 核心：液态玻璃大字 */
  .glass-title {
    font-size: clamp(5rem, 18vw, 15rem);
    font-weight: 900;
    margin: 0;
    letter-spacing: 0.05em;
    position: relative;
    
    /* 内部完全透明，透出背景光 */
    color: transparent;
    
    /* 玻璃材质感：只有边缘有白亮渐变，中间透明 */
    background: linear-gradient(180deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.2) 40%, rgba(255,255,255,0.8) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    
    /* 高光反射：利用多重阴影模拟玻璃厚度 */
    text-shadow: 
      0 0 40px rgba(255, 255, 255, 0.1), /* 外发光 */
      0 0 10px rgba(0, 255, 255, 0.3),
      0 0 20px rgba(255, 0, 128, 0.2);
      
    /* 呼吸放大 + 光影流动 */
    animation: breathe 4s ease-in-out infinite alternate, flow 8s infinite linear;
  }

  /* 用伪元素给文字加上边缘高光描边（模拟玻璃厚度） */
  .glass-title::before {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 0;
    z-index: -1;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.4);
    filter: blur(2px);
  }
  
  /* 增加内部折射光效 */
  .glass-title::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 0;
    z-index: -2;
    color: transparent;
    -webkit-text-stroke: 4px rgba(0, 200, 255, 0.2);
    filter: blur(8px);
  }

  @keyframes breathe {
    0% { transform: scale(1); }
    100% { transform: scale(1.05); }
  }

  @keyframes flow {
    0% { filter: hue-rotate(0deg); }
    100% { filter: hue-rotate(30deg); }
  }

  .glass-sub {
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    color: rgba(255, 255, 255, 0.7);
    margin-top: 2rem;
    letter-spacing: 0.3em;
    font-weight: 300;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    animation: fade-in 2s ease-out;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
