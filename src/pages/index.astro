---
// 纯英文错落排版 + 金属质感 + 剧烈水波震荡
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MIYAMIZU</title>
    <!-- 引入极简高级无衬线字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;800&family=Inter:wght@200;300&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- SVG 滤镜：用于文字水波扭曲 -->
    <svg class="hidden-svg">
      <defs>
        <filter id="water-ripple">
          <feTurbulence id="turbulence" type="fractalNoise" baseFrequency="0.01 0.01" numOctaves="3" result="noise" />
          <feDisplacementMap id="displacement" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>

    <!-- 水波视觉层 -->
    <div id="ripple-container"></div>

    <!-- 内容区（非对称排版） -->
    <main class="layout" id="distort-target">
      
      <!-- 左上角大字 -->
      <h1 class="text-1">TOO</h1>
      
      <!-- 右侧偏上 -->
      <h1 class="text-2">LAZY</h1>
      
      <!-- 左下角大字 -->
      <h1 class="text-3">TO DO IT.</h1>

      <!-- 右下角小字副标题 -->
      <p class="sub-text">
        Bought the domain,<br>
        just make do with it.
      </p>

      <!-- 底部极小字点缀 -->
      <div class="meta-text">
        <span>MIYAMIZU.COM</span>
        <span>CLICK TO DISTORT</span>
      </div>
      
    </main>

    <script is:inline>
      const target = document.getElementById('distort-target');
      const turbulence = document.getElementById('turbulence');
      const displacement = document.getElementById('displacement');
      let animId;
      let scale = 0;
      let freq = 0.01;

      // 触发文字震荡
      function triggerDistort(x, y) {
        cancelAnimationFrame(animId);
        // 初始扭曲强度极大，产生明显形变
        scale = 150; 
        freq = 0.008;

        function animate() {
          // 衰减系数
          scale *= 0.94;
          // 频率慢慢变大，波纹变密
          freq += 0.0005;

          if (scale < 0.5) {
            target.style.filter = 'none';
            return;
          }

          displacement.setAttribute('scale', scale);
          turbulence.setAttribute('baseFrequency', `${freq} ${freq}`);

          animId = requestAnimationFrame(animate);
        }
        animate();
      }

      // 屏幕点击事件
      document.body.addEventListener('pointerdown', (e) => {
        // 1. 触发文字扭曲
        triggerDistort();

        // 2. 生成真实扩散的波纹圈（多层叠加）
        for (let i = 0; i < 3; i++) {
          setTimeout(() => {
            const ripple = document.createElement('div');
            ripple.className = 'ring';
            ripple.style.left = `${e.clientX}px`;
            ripple.style.top = `${e.clientY}px`;
            document.getElementById('ripple-container').appendChild(ripple);

            setTimeout(() => { ripple.remove(); }, 2000);
          }, i * 150); // 层叠延迟
        }
      });
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #0a0a0c; /* 极深太空灰 */
    --text-metallic: linear-gradient(135deg, #ffffff 0%, #888b94 50%, #3a3c42 100%);
    --font-display: 'Syne', sans-serif; /* 极具先锋感的设计师字体 */
    --font-sans: 'Inter', sans-serif;
  }

  html, body {
    margin: 0; padding: 0;
    width: 100%; height: 100%;
    background-color: var(--bg);
    color: white;
    overflow: hidden;
    cursor: crosshair;
    font-family: var(--font-sans);
  }

  .hidden-svg { position: absolute; width: 0; height: 0; }

  /* 非对称排版容器 */
  .layout {
    position: relative;
    width: 100%; height: 100%;
    transition: filter 0.1s linear;
    will-change: filter;
  }

  /* 所有文字的基础样式：金属渐变 */
  .text-1, .text-2, .text-3 {
    font-family: var(--font-display);
    font-weight: 800;
    margin: 0;
    line-height: 0.8;
    background: var(--text-metallic);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    position: absolute;
    /* 加上极其轻微的阴影增加立体感 */
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5));
  }

  /* 错落有致的绝对定位 */
  .text-1 {
    font-size: clamp(6rem, 18vw, 20rem);
    top: 10%;
    left: 8%;
  }

  .text-2 {
    font-size: clamp(6rem, 20vw, 22rem);
    top: 35%;
    right: 12%;
  }

  .text-3 {
    font-size: clamp(5rem, 15vw, 16rem);
    bottom: 15%;
    left: 20%;
  }

  /* 副标题排版 */
  .sub-text {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.5rem);
    font-weight: 200;
    color: #a1a1aa;
    position: absolute;
    bottom: 12%;
    right: 10%;
    text-align: right;
    line-height: 1.6;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* 边角料信息 */
  .meta-text {
    position: absolute;
    top: 5%;
    right: 5%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: #52525b;
    letter-spacing: 0.2em;
  }

  /* 扩散的水波纹圈 */
  .ring {
    position: absolute;
    width: 10px; height: 10px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    box-shadow: 0 0 20px rgba(255,255,255,0.1);
    /* 使用 cubic-bezier 模拟物理回弹减速 */
    animation: ripple-grow 2s cubic-bezier(0.1, 0.8, 0.2, 1) forwards;
  }

  @keyframes ripple-grow {
    0% { width: 10px; height: 10px; opacity: 1; border-width: 4px; }
    100% { width: 200vmax; height: 200vmax; opacity: 0; border-width: 1px; }
  }
</style>
