---
// 纯黑底 + 电影级纵深滚动 + 英国华丽手写体
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Make do</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Pinyon+Script&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- 制造向下滚动的空间 -->
    <div class="scroll-container">
      <!-- 固定不动的视口镜头 -->
      <div class="sticky-wrapper">
        <h1 class="text-1">Make do</h1>
        <h2 class="text-2">aesthetic offline today</h2>
      </div>
      
      <!-- 滚动提示 -->
      <div class="scroll-hint">
        <span>SCROLL DOWN</span>
        <div class="line"></div>
      </div>
    </div>

    <!-- 引入顶级动画库 GSAP 和 丝滑滚动库 Lenis -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>

    <script is:inline>
      // 等待库加载
      window.addEventListener('load', () => {
        
        // 1. 初始化丝滑滚动 (Lenis)
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          touchMultiplier: 2,
        });

        function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // 2. 注册 GSAP 滚动触发器
        gsap.registerPlugin(ScrollTrigger);
        
        // 让 ScrollTrigger 和 Lenis 同步
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => { lenis.raf(time * 1000); });
        gsap.ticker.lagSmoothing(0);

        // 3. 核心电影级镜头动画
        // 第一句：放大、虚化、隐去
        gsap.to(".text-1", {
          scale: 1.8,
          opacity: 0,
          filter: "blur(24px)",
          scrollTrigger: {
            trigger: ".scroll-container",
            start: "top top",
            end: "50% top",
            scrub: 1.5, // 平滑追随滚动
          }
        });

        // 第二句：从极小的深渊中浮现、聚焦、清晰
        gsap.fromTo(".text-2", 
          {
            scale: 0.6,
            opacity: 0,
            filter: "blur(20px)",
            y: 100
          },
          {
            scale: 1,
            opacity: 1,
            filter: "blur(0px)",
            y: 0,
            scrollTrigger: {
              trigger: ".scroll-container",
              start: "40% top",
              end: "90% top",
              scrub: 1.5,
            }
          }
        );

        // 滚动提示淡出
        gsap.to(".scroll-hint", {
          opacity: 0,
          scrollTrigger: {
            trigger: ".scroll-container",
            start: "top top",
            end: "20% top",
            scrub: true,
          }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    background-color: #000000;
    color: #ffffff;
    overflow-x: hidden;
    /* 隐藏系统默认滚动条，让画面更纯粹 */
    scrollbar-width: none;
  }
  body::-webkit-scrollbar {
    display: none;
  }

  /* 制造 300vh 的滚动距离，给足镜头推进的空间 */
  .scroll-container {
    height: 300vh;
    position: relative;
  }

  /* 视口镜头：死死钉在屏幕上 */
  .sticky-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none; /* 防止文字拦截滚动 */
  }

  .text-1, .text-2 {
    position: absolute;
    font-family: 'Pinyon Script', cursive;
    font-weight: 400;
    color: #ffffff;
    text-align: center;
    /* 极致的平滑渲染 */
    -webkit-font-smoothing: antialiased;
    will-change: transform, opacity, filter;
  }

  .text-1 {
    font-size: clamp(8rem, 20vw, 25rem);
    line-height: 1;
  }

  .text-2 {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(4rem, 10vw, 12rem);
    line-height: 1.2;
    /* 初始隐藏，等待 GSAP 唤醒 */
    opacity: 0; 
  }

  /* 右下角的极简滚动提示 */
  .scroll-hint {
    position: fixed;
    bottom: 3rem;
    right: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    font-family: monospace;
    font-size: 0.7rem;
    color: #666;
    letter-spacing: 0.2em;
    z-index: 10;
  }

  .scroll-hint .line {
    width: 1px;
    height: 50px;
    background-color: #333;
    animation: pulse 2s infinite;
    transform-origin: top;
  }

  @keyframes pulse {
    0% { transform: scaleY(0); opacity: 1; }
    50% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }
</style>
