<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>多邻国课后训练 - 日语填空</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background-color: #f7f9fc; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; color: #333; }
    .card { background: #fff; width: 90%; max-width: 400px; border-radius: 20px; padding: 30px 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); text-align: center; }
    .sentence { font-size: 32px; font-weight: bold; letter-spacing: 2px; margin-bottom: 10px; color: #222; }
    .chinese { font-size: 16px; color: #888; margin-bottom: 30px; }
    input[type="text"] { width: 80%; font-size: 20px; padding: 12px; border: 2px solid #e0e0e0; border-radius: 12px; text-align: center; outline: none; background-color: #fafafa; }
    input[type="text"]:focus { border-color: #58cc02; background-color: #fff; }
    .feedback { height: 24px; margin-top: 15px; font-weight: bold; font-size: 16px; }
    .correct { color: #58cc02; }
    .incorrect { color: #ff4b4b; }
    .actions { margin-top: 20px; display: flex; flex-direction: column; gap: 12px; }
    button { width: 100%; padding: 15px; font-size: 16px; font-weight: bold; border: none; border-radius: 12px; cursor: pointer; }
    #submit-btn { background-color: #58cc02; color: white; box-shadow: 0 4px 0 #46a302; }
    #next-btn { background-color: #1cb0f6; color: white; box-shadow: 0 4px 0 #1899d6; display: none; }
    #play-btn { background-color: #fff; color: #1cb0f6; border: 2px solid #1cb0f6; margin-top: 10px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="sentence" id="question-sentence">これは＿です</div>
    <div class="chinese" id="question-chinese">这是书</div>
    <input type="text" id="answer-input" placeholder="输入填空内容" autocomplete="off" />
    <div class="feedback" id="feedback"></div>
    <div class="actions">
      <button id="submit-btn">提 交</button>
      <button id="next-btn">下 一 题</button>
      <button id="play-btn">🔊 听发音</button>
    </div>
  </div>
  <script>
    const quizData = [
      { sentence: "これは＿です", answer: "本", chinese: "这是书" },
      { sentence: "水を＿", answer: "ください", chinese: "请给我水" },
      { sentence: "猫が＿", answer: "います", chinese: "有猫" }
    ];
    const sentenceEl = document.getElementById('question-sentence');
    const chineseEl = document.getElementById('question-chinese');
    const inputEl = document.getElementById('answer-input');
    const feedbackEl = document.getElementById('feedback');
    const submitBtn = document.getElementById('submit-btn');
    const nextBtn = document.getElementById('next-btn');
    const playBtn = document.getElementById('play-btn');
    let currentIndex = 0;
    function loadQuestion() {
      const currentQ = quizData[currentIndex];
      sentenceEl.innerText = currentQ.sentence;
      chineseEl.innerText = currentQ.chinese;
      inputEl.value = '';
      feedbackEl.innerText = '';
      submitBtn.style.display = 'block';
      nextBtn.style.display = 'none';
      inputEl.disabled = false;
      inputEl.focus();
    }
    submitBtn.addEventListener('click', () => {
      const userAnswer = inputEl.value.trim();
      if (!userAnswer) return;
      const correctAnswer = quizData[currentIndex].answer;
      if (userAnswer === correctAnswer) {
        feedbackEl.innerText = '答对了！太棒了 🎉';
        feedbackEl.className = 'feedback correct';
      } else {
        feedbackEl.innerText = '答错了，正确答案是：' + correctAnswer + ' 😢';
        feedbackEl.className = 'feedback incorrect';
      }
      submitBtn.style.display = 'none';
      nextBtn.style.display = 'block';
      inputEl.disabled = true;
    });
    inputEl.addEventListener('keypress', (e) => { if (e.key === 'Enter') submitBtn.click(); });
    nextBtn.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % quizData.length;
      loadQuestion();
    });
    playBtn.addEventListener('click', () => {
      const currentQ = quizData[currentIndex];
      const fullSentence = currentQ.sentence.replace('＿', currentQ.answer);
      const utterance = new SpeechSynthesisUtterance(fullSentence);
      utterance.lang = 'ja-JP';
      utterance.rate = 0.9;
      window.speechSynthesis.speak(utterance);
    });
    loadQuestion();
  </script>
</body>
</html>
