<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>多邻国日语 - 第一课点餐练习</title>
  <style>
    :root { --duo-green: #58cc02; --duo-green-shadow: #46a302; --duo-blue: #1cb0f6; }
    body { font-family: "Nunito", -apple-system, sans-serif; background: #fff; display: flex; flex-direction: column; align-items: center; min-height: 100vh; margin: 0; color: #4b4b4b; user-select: none; }
    
    .top-bar { width: 100%; max-width: 600px; padding: 20px; display: flex; justify-content: space-between; align-items: center; box-sizing: border-box; }
    .progress-text { font-weight: bold; color: #afafaf; font-size: 16px; }

    .main-content { width: 100%; max-width: 600px; padding: 20px; flex: 1; display: flex; flex-direction: column; }
    .question-hint { font-size: 22px; font-weight: bold; margin-bottom: 30px; }
    
    .answer-area { min-height: 100px; border-bottom: 2px solid #e5e5e5; margin-bottom: 40px; display: flex; flex-wrap: wrap; gap: 10px; align-content: flex-start; padding-bottom: 10px; }
    
    .block { padding: 10px 16px; border-radius: 12px; font-size: 20px; font-weight: bold; cursor: pointer; transition: all 0.1s; }
    
    .block.selected { background: #fff; border: 2px solid #e5e5e5; border-bottom-width: 4px; color: #4b4b4b; }
    .block.selected:active { border-bottom-width: 2px; transform: translateY(2px); }
    
    .block.bank { background: #f7f7f7; border: 2px solid #e5e5e5; border-bottom-width: 4px; color: #4b4b4b; }
    .block.bank:active { border-bottom-width: 2px; transform: translateY(2px); }
    .block.placeholder { background: #f0f0f0; color: transparent; pointer-events: none; border: 2px solid transparent; }

    .bottom-panel { width: 100%; max-width: 600px; border-top: 2px solid #e5e5e5; background: #fff; padding: 20px; box-sizing: border-box; position: fixed; bottom: 0; }
    .feedback-box { display: none; margin-bottom: 15px; padding: 15px; border-radius: 12px; background: #ddf4ff; }
    .feedback-title { font-size: 20px; font-weight: bold; margin-bottom: 5px; color: var(--duo-blue); }
    .feedback-title.error { color: #ea2b2b; }
    .feedback-desc { font-size: 16px; color: #4b4b4b; }
    
    button.action-btn { width: 100%; padding: 16px; border-radius: 16px; font-size: 18px; font-weight: bold; border: none; cursor: pointer; text-transform: uppercase; transition: all 0.1s; }
    #check-btn { background: var(--duo-green); color: white; box-shadow: 0 4px 0 var(--duo-green-shadow); }
    #check-btn:disabled { background: #e5e5e5; box-shadow: none; color: #afafaf; cursor: not-allowed; }
    #check-btn:active:not(:disabled) { box-shadow: 0 0 0; transform: translateY(4px); }
    #next-btn { background: var(--duo-green); color: white; box-shadow: 0 4px 0 var(--duo-green-shadow); display: none; }
    #next-btn:active { box-shadow: 0 0 0; transform: translateY(4px); }
  </style>
</head>
<body>
  <div class="top-bar">
    <div class="progress-text">Unit 1 · 点餐与饮料</div>
  </div>

  <div class="main-content">
    <div class="question-hint">翻译这句话：<br><span id="chinese-hint" style="color:#333; font-size:28px;">请给我水</span></div>
    <div class="answer-area" id="answer-area"></div>
    <div style="font-size: 14px; color: #afafaf; margin-bottom: 20px;">点击下方词块拼出日文</div>
    <div class="bank-area" id="bank-area" style="display: flex; flex-wrap: wrap; gap: 10px;"></div>
  </div>

  <div class="bottom-panel">
    <div class="feedback-box" id="feedback-box">
      <div class="feedback-title" id="feedback-title">太棒了！</div>
      <div class="feedback-desc" id="feedback-desc"></div>
    </div>
    <button class="action-btn" id="check-btn" disabled>检查</button>
    <button class="action-btn" id="next-btn">继续</button>
  </div>

  <script>
    // 完全基于多邻国 Section 1, Unit 1 "Order food and drinks" 真实语料
    const quizData = [
      { 
        chinese: "请给我水", 
        answer: "みずください", 
        blocks: ["ください", "みず", "です"],
        explain: "「ください」放在名词后面，表示“请给我...”。"
      },
      { 
        chinese: "是茶", 
        answer: "おちゃです", 
        blocks: ["です", "おちゃ", "ください"],
        explain: "「です」表示判断，相当于“是...”。"
      },
      { 
        chinese: "请给我寿司", 
        answer: "すしください", 
        blocks: ["ください", "ごはん", "すし"],
        explain: "「すし」是寿司。多邻国非常喜欢让你点寿司。"
      },
      { 
        chinese: "请给我饭和茶", 
        answer: "ごはんとおちゃください", 
        blocks: ["おちゃ", "ごはん", "と", "ください"],
        explain: "「と」连接两个名词，表示“和”。"
      },
      { 
        chinese: "是水", 
        answer: "みずです", 
        blocks: ["みず", "ください", "です"],
        explain: "非常直接的判断句。"
      }
    ];

    let currentIndex = 0;
    let currentSelectedBlocks = [];
    let isAnswered = false;

    const chineseHint = document.getElementById('chinese-hint');
    const answerArea = document.getElementById('answer-area');
    const bankArea = document.getElementById('bank-area');
    const checkBtn = document.getElementById('check-btn');
    const nextBtn = document.getElementById('next-btn');
    const feedbackBox = document.getElementById('feedback-box');
    const feedbackTitle = document.getElementById('feedback-title');
    const feedbackDesc = document.getElementById('feedback-desc');

    function shuffle(array) {
      return array.sort(() => Math.random() - 0.5);
    }

    function loadQuestion() {
      isAnswered = false;
      currentSelectedBlocks = [];
      feedbackBox.style.display = 'none';
      checkBtn.style.display = 'block';
      nextBtn.style.display = 'none';
      checkBtn.disabled = true;
      
      const q = quizData[currentIndex];
      chineseHint.innerText = q.chinese;
      
      answerArea.innerHTML = '';
      bankArea.innerHTML = '';
      
      shuffle([...q.blocks]).forEach(text => {
        const btn = document.createElement('div');
        btn.className = 'block bank';
        btn.innerText = text;
        btn.onclick = () => moveToAnswer(btn);
        bankArea.appendChild(btn);
      });
    }

    function moveToAnswer(btn) {
      if (isAnswered) return;
      btn.classList.remove('bank');
      btn.classList.add('placeholder');
      btn.onclick = null;
      
      const newBtn = document.createElement('div');
      newBtn.className = 'block selected';
      newBtn.innerText = btn.innerText;
      newBtn.onclick = () => moveToBank(newBtn, btn);
      
      answerArea.appendChild(newBtn);
      currentSelectedBlocks.push(btn.innerText);
      checkBtn.disabled = currentSelectedBlocks.length === 0;
    }

    function moveToBank(newBtn, originalBtn) {
      if (isAnswered) return;
      answerArea.removeChild(newBtn);
      const idx = currentSelectedBlocks.indexOf(newBtn.innerText);
      if (idx > -1) currentSelectedBlocks.splice(idx, 1);
      
      originalBtn.classList.remove('placeholder');
      originalBtn.classList.add('bank');
      originalBtn.onclick = () => moveToAnswer(originalBtn);
      checkBtn.disabled = currentSelectedBlocks.length === 0;
    }

    checkBtn.onclick = () => {
      isAnswered = true;
      checkBtn.disabled = true;
      
      const q = quizData[currentIndex];
      const userAnswer = currentSelectedBlocks.join('');
      
      if (userAnswer === q.answer) {
        feedbackBox.style.display = 'block';
        feedbackBox.style.background = '#d7ffb8';
        feedbackTitle.className = 'feedback-title';
        feedbackTitle.style.color = '#58a700';
        feedbackTitle.innerText = '太棒了！回答正确！';
        feedbackDesc.innerText = q.explain;
        
        const utterance = new SpeechSynthesisUtterance(q.answer);
        utterance.lang = 'ja-JP';
        utterance.rate = 0.85;
        window.speechSynthesis.speak(utterance);
      } else {
        feedbackBox.style.display = 'block';
        feedbackBox.style.background = '#ffdfe0';
        feedbackTitle.className = 'feedback-title error';
        feedbackTitle.style.color = '#ea2b2b';
        feedbackTitle.innerText = '正确答案是：';
        feedbackDesc.innerHTML = `<b style="font-size:20px; color:#333;">${q.answer}</b><br><br>${q.explain}`;
      }
      
      checkBtn.style.display = 'none';
      nextBtn.style.display = 'block';
    };

    nextBtn.onclick = () => {
      currentIndex = (currentIndex + 1) % quizData.length;
      loadQuestion();
    };

    loadQuestion();
  </script>
</body>
</html>
